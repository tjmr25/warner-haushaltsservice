---
/**
 * Footer – Warner Haushaltsservice
 * Mobile First → Desktop (≥ 1024px)
 * Spalten: Logo+Beschreibung | Navigation | Leistungen | Kontakt
 * Bottom-Bar: Copyright + Rechtliches
 */
const currentYear = new Date().getFullYear();
---

<footer class="bg-(--color-dark) text-[#c8cfd4] font-[family-name:var(--font-body)]">

  <!-- =============================================
       HAUPTBEREICH
       ============================================= -->
  <div class="px-5 pt-12 pb-10 lg:px-8 lg:pt-16 lg:pb-14 max-w-[1200px] mx-auto">
    <div class="grid gap-10 grid-cols-1 lg:grid-cols-[1.6fr_1fr_1fr_1.4fr] lg:gap-12">

      <!-- Spalte 1: Logo + Beschreibung -->
      <div>
        <a
          href="/"
          class="inline-block mb-4 transition-opacity duration-200 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-2 focus-visible:rounded-[2px]"
          aria-label="Warner Haushaltsservice – Zur Startseite"
        >
          <img
            src="/images/logo_warner.svg"
            alt="Warner Haushaltsservice Logo"
            width="180"
            height="59"
            loading="lazy"
            class="h-10 w-auto object-contain brightness-0 invert"
          />
        </a>
        <p class="text-[0.9375rem] leading-[1.7] text-[#9aa5ad] mb-5 max-w-[28ch] lg:max-w-[32ch]">
          Ihr verlässlicher Partner für Haushalt und Pflege in Hamburg –
          seit über 25 Jahren.
        </p>
      </div>

      <!-- Spalte 2: Navigation -->
      <div>
        <h3 class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-white mb-4 pb-[0.625rem] border-b border-white/[0.08]">
          Navigation
        </h3>
        <ul class="list-none m-0 p-0 flex flex-col gap-[0.625rem]">
          <li><a href="/" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Startseite</a></li>
          <li><a href="/pflegebeduerfte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Pflegebedürftige</a></li>
          <li><a href="/privathaushalte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Privathaushalte</a></li>
          <li><a href="/ueber-uns" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Über uns</a></li>
          <li><a href="/preise" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Preise</a></li>
          <li><a href="/kontakt" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Kontakt</a></li>
        </ul>
      </div>

      <!-- Spalte 3: Leistungen -->
      <div>
        <h3 class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-white mb-4 pb-[0.625rem] border-b border-white/[0.08]">
          Leistungen
        </h3>
        <ul class="list-none m-0 p-0 flex flex-col gap-[0.625rem]">
          <li><a href="/pflegebeduerfte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Alltagsbegleitung</a></li>
          <li><a href="/pflegebeduerfte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Abrechnung mit Pflegekasse</a></li>
          <li><a href="/privathaushalte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Haushaltsreinigung</a></li>
          <li><a href="/privathaushalte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Wäscheservice</a></li>
          <li><a href="/privathaushalte" class="text-[0.9375rem] text-[#9aa5ad] no-underline inline-block transition-colors duration-[180ms] hover:text-(--color-primary-300) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[3px] focus-visible:rounded-[2px]">Einkaufshilfe</a></li>
        </ul>
      </div>

      <!-- Spalte 4: Kontakt -->
      <div>
        <h3 class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-white mb-4 pb-[0.625rem] border-b border-white/[0.08]">
          Kontakt
        </h3>
        <address class="not-italic">
          <ul class="list-none m-0 p-0 flex flex-col gap-[0.625rem]">

            <!-- Adresse -->
            <li class="flex items-start gap-[0.625rem] text-[#9aa5ad] text-[0.9375rem] leading-[1.6]">
              <span class="shrink-0 mt-[0.2rem] text-(--color-primary-400) flex" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <span>Warner Haushaltsservice<br />Haubachstraße 80<br />22765 Hamburg</span>
            </li>

            <!-- Telefon -->
            <li class="flex items-start gap-[0.625rem] text-[#9aa5ad] text-[0.9375rem] leading-[1.6]">
              <span class="shrink-0 mt-[0.2rem] text-(--color-primary-400) flex" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.29h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/>
                </svg>
              </span>
              <a href="tel:+494029812540" class="text-[#9aa5ad] no-underline transition-colors duration-[180ms] hover:text-(--color-primary-300)">040 / 29 81 25 40</a>
            </li>

            <!-- E-Mail -->
            <li class="flex items-start gap-[0.625rem] text-[#9aa5ad] text-[0.9375rem] leading-[1.6]">
              <span class="shrink-0 mt-[0.2rem] text-(--color-primary-400) flex" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
              </span>
              <a href="mailto:info@warner-hamburg.de" class="text-[#9aa5ad] no-underline transition-colors duration-[180ms] hover:text-(--color-primary-300)">info@warner-hamburg.de</a>
            </li>

            <!-- Öffnungszeiten -->
            <li class="flex items-start gap-[0.625rem] text-[#9aa5ad] text-[0.9375rem] leading-[1.6]">
              <span class="shrink-0 mt-[0.2rem] text-(--color-primary-400) flex" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
              </span>
              <span>Mo – Fr: 08:00 – 14:00 Uhr</span>
            </li>

          </ul>
        </address>
      </div>

    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-white/[0.08] mx-5 lg:mx-8" aria-hidden="true"></div>

  <!-- =============================================
       BOTTOM-BAR: Copyright + Rechtliches
       ============================================= -->
  <div class="px-5 py-5 lg:px-8 max-w-[1200px] mx-auto">
    <div class="flex flex-col gap-3 items-start lg:flex-row lg:justify-between lg:items-center">

      <p class="text-[0.8125rem] text-[#6b7880] m-0">
        &copy; {currentYear} Warner Haushaltsservice GmbH. Alle Rechte vorbehalten.
      </p>

      <nav class="flex items-center gap-2 flex-wrap" aria-label="Rechtliche Links">
        <a
          href="/impressum"
          class="text-[0.8125rem] text-[#6b7880] no-underline transition-colors duration-[180ms] hover:text-[#c8cfd4] focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-2 focus-visible:rounded-[2px]"
        >Impressum</a>
        <span class="text-[#3d4a52] text-[0.75rem]" aria-hidden="true">·</span>
        <a
          href="/datenschutz"
          class="text-[0.8125rem] text-[#6b7880] no-underline transition-colors duration-[180ms] hover:text-[#c8cfd4] focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-2 focus-visible:rounded-[2px]"
        >Datenschutz</a>
      </nav>

    </div>
  </div>

</footer>
