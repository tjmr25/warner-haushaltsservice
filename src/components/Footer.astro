---
const currentYear = new Date().getFullYear();
---

<footer id="site-footer" role="contentinfo">
  <div class="footer-main">
    <div class="container-content">
      <div class="footer-grid">

        <!-- Brand Column -->
        <div class="footer-brand">
          <a href="/" aria-label="Warner Haushaltsservice – Zur Startseite">
            <img
              src="/logo.svg"
              alt="Warner Haushaltsservice GmbH"
              width="160"
              height="70"
              loading="lazy"
            />
          </a>
          <p class="footer-tagline">
            Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen und
            Alltagsunterstützung für Pflegebedürftige in Hamburg.
          </p>
          <div class="footer-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Von der Stadt Hamburg anerkannt</span>
          </div>
        </div>

        <!-- Navigation Column -->
        <nav class="footer-nav" aria-label="Footer-Navigation">
          <h3 class="footer-heading">Navigation</h3>
          <ul role="list">
            <li><a href="/">Startseite</a></li>
            <li><a href="/privathaushalte">Privathaushalte</a></li>
            <li><a href="/pflegebeduerfte">Pflegebedürftige</a></li>
            <li><a href="/ueber-uns">Über uns</a></li>
            <li><a href="/preise">Preise</a></li>
            <li><a href="/kontakt">Kontakt</a></li>
          </ul>
        </nav>

        <!-- Services Column -->
        <div class="footer-services">
          <h3 class="footer-heading">Leistungen</h3>
          <ul role="list">
            <li>Reinigung & Ordnung</li>
            <li>Wäschepflege & Bügeln</li>
            <li>Alltagsunterstützung</li>
            <li>Abrechnung über Pflegekasse</li>
            <li>Gesellschaft & Begleitung</li>
          </ul>
        </div>

        <!-- Contact Column -->
        <div class="footer-contact">
          <h3 class="footer-heading">Kontakt</h3>
          <address>
            <div class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <div>
                <span>Warner Haushaltsservice</span><br />
                <span>Haubachstraße 80</span><br />
                <span>22765 Hamburg</span>
              </div>
            </div>

            <div class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
              </svg>
              <a href="tel:+4940298125400">040 / 29 81 25 40</a>
            </div>

            <div class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              <a href="mailto:info@warner-hamburg.de">info@warner-hamburg.de</a>
            </div>
          </address>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom Bar -->
  <div class="footer-bottom">
    <div class="container-content">
      <p>
        &copy; {currentYear} Warner Haushaltsservice GmbH · Hamburg.
        Alle Rechte vorbehalten.
      </p>
      <div class="footer-bottom-links">
        <a href="/datenschutz">Datenschutz</a>
        <span aria-hidden="true">·</span>
        <a href="/impressum">Impressum</a>
      </div>
    </div>
  </div>
</footer>

<style>
  #site-footer {
    margin-top: auto;
  }

  /* ===== FOOTER MAIN ===== */
  .footer-main {
    background-color: #2a2018;
    color: #e8e2d6;
    padding-top: 4rem;
    padding-bottom: 3rem;
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 3rem;
    }
  }

  /* ===== BRAND ===== */
  .footer-brand img {
    filter: brightness(0) invert(1);
    opacity: 0.9;
    margin-bottom: 1rem;
    max-width: 140px;
    height: auto;
  }

  .footer-tagline {
    font-size: 0.9rem;
    line-height: 1.65;
    color: #b8ab9a;
    margin: 0 0 1.25rem;
  }

  .footer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 183, 48, 0.12);
    border: 1px solid rgba(255, 183, 48, 0.25);
    border-radius: 2rem;
    padding: 0.4rem 0.875rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffc84a;
  }

  /* ===== HEADING ===== */
  .footer-heading {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffb730;
    margin: 0 0 1rem;
  }

  /* ===== NAV / SERVICES ===== */
  .footer-nav ul,
  .footer-services ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a,
  .footer-services li {
    color: #b8ab9a;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s ease;
    line-height: 1.5;
  }

  .footer-nav a:hover {
    color: #ecd8b5;
  }

  /* ===== CONTACT ===== */
  .footer-contact address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: #b8ab9a;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .contact-item svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .contact-item a {
    color: #b8ab9a;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-item a:hover {
    color: #ecd8b5;
  }

  /* ===== BOTTOM BAR ===== */
  .footer-bottom {
    background-color: #1a130e;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .footer-bottom .container-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 640px) {
    .footer-bottom .container-content {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-bottom p {
    font-size: 0.8125rem;
    color: #7d6e5e;
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom-links a {
    font-size: 0.8125rem;
    color: #7d6e5e;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-bottom-links a:hover {
    color: #b8ab9a;
  }

  .footer-bottom-links span {
    color: #4a3d34;
  }
</style>
