---
/**
 * Header – Warner Haushaltsservice
 * Mobile First: Logo links | Hamburger rechts | Slide-down Menü
 * Desktop (≥1024px): Logo links | Nav-Links rechts | Kontakt als Button
 * Aktive Seite wird automatisch erkannt und hervorgehoben.
 */
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Startseite' },
  { href: '/pflegebeduerfte', label: 'Pflegebedürftige' },
  { href: '/privathaushalte', label: 'Privathaushalte' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/preise', label: 'Preise' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const isKontaktActive = currentPath.startsWith('/kontakt');
// Transparent header ONLY on the start page (homepage)
const hasTransparentHeader = currentPath === '/';
---

<!-- =============================================
     HEADER
     sticky + weißer Hintergrund (Standard)
     Mit Hero-Bild: fixed + transparent → via CSS-Klasse wh-header-transparent
     ============================================= -->
<header
  id="siteHeader"
  class={`sticky top-0 z-[100] w-full bg-(--color-base) border-b border-(--color-secondary) shadow-[0_2px_12px_0_rgb(27_34_39/0.06)] ${hasTransparentHeader ? 'wh-header-transparent' : ''}`}
>
  <!-- Inner: Logo + Nav + Burger -->
  <div class="container-page flex items-center justify-between py-[0.875rem] w-full lg:min-h-[68px] lg:py-0">

    <!-- Logo -->
    <a
      href="/"
      class="flex items-center shrink-0 transition-opacity duration-200 hover:opacity-85"
      aria-label="Warner Haushaltsservice – Zur Startseite"
    >
      <img
        src="/images/logo_warner.svg"
        alt="Warner Haushaltsservice Logo"
        width="160"
        height="53"
        loading="eager"
        fetchpriority="high"
        class="h-[44px] lg:h-[50px] w-auto object-contain"
      />
    </a>

    <!-- =============================================
         DESKTOP NAVIGATION (≥1024px)
         ============================================= -->
    <nav class="hidden lg:flex items-center gap-2" aria-label="Hauptnavigation">
      <ul class="flex items-center gap-1 list-none m-0 p-0">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`nav-link inline-flex items-center px-[0.875rem] py-2 font-[family-name:var(--font-body)] text-[0.9375rem] font-medium text-(--color-dark) no-underline rounded-[var(--radius)] transition-colors duration-[180ms] whitespace-nowrap ${isActive(link.href) ? 'nav-link-active text-(--color-primary-700)' : 'hover:text-(--color-primary-700)'}`}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Kontakt-Button (Desktop) -->
      <a
        href="/kontakt"
        class={`inline-flex items-center ml-3 font-[family-name:var(--font-heading)] text-[0.9375rem] font-bold rounded-[var(--radius)] no-underline whitespace-nowrap transition-all duration-[250ms] focus-visible:outline-2 focus-visible:outline-(--color-dark) focus-visible:outline-offset-3 ${
          isKontaktActive
            ? 'bg-transparent border-2 border-(--color-primary-600) text-(--color-primary-900) shadow-none px-[calc(1.25rem-2px)] py-[calc(0.5rem-2px)]'
            : 'bg-(--color-primary-500) border-2 border-(--color-primary-500) text-(--color-dark) shadow-[0_2px_8px_0_rgb(255_183_48/0.28)] px-[calc(1.25rem-2px)] py-[calc(0.5rem-2px)] hover:bg-(--color-primary-400) hover:border-(--color-primary-400)'
        }`}
        aria-current={isKontaktActive ? 'page' : undefined}
      >
        Kontakt
      </a>
    </nav>

    <!-- =============================================
         HAMBURGER BUTTON (Mobile only)
         ============================================= -->
    <button
      id="burgerBtn"
      class="flex lg:hidden flex-col justify-center items-center gap-[5px] w-11 h-11 p-[6px] bg-transparent border-none rounded-[var(--radius)] cursor-pointer shrink-0 transition-colors duration-200 hover:bg-(--color-primary-50) focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-2"
      aria-expanded="false"
      aria-controls="mobileNav"
      aria-label="Menü öffnen"
      type="button"
    >
      <span class="burger-bar block w-[22px] h-[2px] bg-(--color-dark) rounded-[2px] origin-center transition-[transform_0.3s_cubic-bezier(0.4,0,0.2,1),opacity_0.2s_ease,width_0.3s_ease]"></span>
      <span class="burger-bar block w-[22px] h-[2px] bg-(--color-dark) rounded-[2px] origin-center transition-[transform_0.3s_cubic-bezier(0.4,0,0.2,1),opacity_0.2s_ease,width_0.3s_ease]"></span>
      <span class="burger-bar block w-[22px] h-[2px] bg-(--color-dark) rounded-[2px] origin-center transition-[transform_0.3s_cubic-bezier(0.4,0,0.2,1),opacity_0.2s_ease,width_0.3s_ease]"></span>
    </button>
  </div>

  <!-- =============================================
       MOBILE NAVIGATION (< 1024px)
       ============================================= -->
  <nav
    id="mobileNav"
    class="lg:hidden bg-(--color-base) border-t border-(--color-secondary) overflow-hidden max-h-0 opacity-0 invisible transition-[max-height_0.35s_cubic-bezier(0.4,0,0.2,1),opacity_0.25s_ease]"
    aria-label="Hauptnavigation"
    aria-hidden="true"
  >
    <ul class="list-none m-0 py-2 px-0">
      {
        [...navLinks, { href: '/kontakt', label: 'Kontakt' }].map((link) => {
          const active = isActive(link.href) || (link.href === '/kontakt' && isKontaktActive);
          const isKontakt = link.href === '/kontakt';
          return (
            <li class="border-b border-(--color-base-alt) last:border-b-0">
              <a
                href={link.href}
                class={`flex items-center gap-[0.625rem] px-4 py-4 font-[family-name:var(--font-body)] text-[1.0625rem] font-medium no-underline transition-[background-color_0.18s_ease,color_0.18s_ease] focus-visible:outline-2 focus-visible:outline-(--color-primary-500) focus-visible:outline-offset-[-2px] ${isKontakt ? 'font-bold' : ''} ${active ? 'text-(--color-primary-700) bg-(--color-primary-100)' : 'text-(--color-dark) hover:bg-(--color-primary-50) hover:text-(--color-primary-700)'}`}
                aria-current={active ? 'page' : undefined}
              >
                {active && (
                  <span
                    class="inline-block w-[5px] h-6 bg-(--color-primary-500) rounded-[2px] shrink-0"
                    aria-hidden="true"
                  />
                )}
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  function initBurger() {
    const burger = document.getElementById('burgerBtn') as HTMLButtonElement | null;
    const nav = document.getElementById('mobileNav') as HTMLElement | null;
    const header = document.getElementById('siteHeader') as HTMLElement | null;

    if (!burger || !nav || !header) return;
    if (burger.dataset.initialized === 'true') return;
    burger.dataset.initialized = 'true';

    function toggleMenu(forceClose = false) {
      const isOpen = nav!.classList.contains('mobile-nav-open');
      const shouldOpen = forceClose ? false : !isOpen;

      nav!.classList.toggle('mobile-nav-open', shouldOpen);
      burger!.classList.toggle('burger-open', shouldOpen);
      burger!.setAttribute('aria-expanded', String(shouldOpen));
      burger!.setAttribute('aria-label', shouldOpen ? 'Menü schließen' : 'Menü öffnen');
      nav!.setAttribute('aria-hidden', String(!shouldOpen));
      header!.classList.toggle('wh-header-nav-open', shouldOpen);

      document.body.style.overflow = shouldOpen ? 'hidden' : '';
    }

    burger.addEventListener('click', () => toggleMenu());

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => toggleMenu(true));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggleMenu(true);
    });
  }

  function initScroll() {
    const header = document.getElementById('siteHeader') as HTMLElement | null;
    if (!header) return;
    if (header.dataset.scrollInitialized === 'true') return;
    header.dataset.scrollInitialized = 'true';

    function handleScroll() {
      if (window.scrollY > 10) {
        header!.classList.add('wh-header-scrolled');
      } else {
        header!.classList.remove('wh-header-scrolled');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  function initHeader() {
    initBurger();
    initScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }

  document.addEventListener('astro:page-load', initHeader);

  document.addEventListener('astro:before-preparation', () => {
    document.body.style.overflow = '';
  });
</script>
