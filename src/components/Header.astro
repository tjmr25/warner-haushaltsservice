---
const navLinks = [
  { href: '/',                  label: 'Startseite'       },
  { href: '/privathaushalte',   label: 'Privathaushalte'  },
  { href: '/pflegebeduerfte',   label: 'Pflegebedürftige' },
  { href: '/ueber-uns',         label: 'Über uns'         },
  { href: '/preise',            label: 'Preise'           },
  { href: '/kontakt',           label: 'Kontakt'          },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" role="banner">
  <div class="header-inner container-content">

    <!-- Logo -->
    <a href="/" class="header-logo" aria-label="Warner Haushaltsservice – Zur Startseite">
      <img
        src="/logo.svg"
        alt="Warner Haushaltsservice GmbH Logo"
        width="180"
        height="78"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="header-nav" aria-label="Hauptnavigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': currentPath === link.href }]}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- CTA Button (Desktop) -->
    <a href="tel:+4940298125400" class="header-cta btn-primary" aria-label="Jetzt anrufen: 040 29 81 25 40">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
      </svg>
      Jetzt anrufen
    </a>

    <!-- Hamburger Button (Mobile) -->
    <button
      id="menu-toggle"
      class="hamburger"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
      type="button"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Hauptnavigation"
    hidden
  >
    <nav aria-label="Mobile Navigation">
      <ul role="list">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class:list={['mobile-nav-link', { 'mobile-nav-link--active': currentPath === link.href }]}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu-footer">
      <a href="tel:+4940298125400" class="btn-primary" style="width: 100%; justify-content: center;">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
        </svg>
        040 / 29 81 25 40
      </a>
      <p class="mobile-menu-address">
        Haubachstraße 80 · 22765 Hamburg
      </p>
    </div>
  </div>
</header>

<style>
  /* ===== HEADER SHELL ===== */
  #site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(251, 249, 244, 0.97);
    border-bottom: 1px solid #e8e2d6;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }

  #site-header.is-scrolled {
    box-shadow: 0 2px 20px rgba(42, 32, 24, 0.08);
    background-color: rgba(251, 249, 244, 0.99);
  }

  /* ===== HEADER INNER ===== */
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;   /* 72px – mobile */
    gap: 1rem;
  }

  @media (min-width: 1024px) {
    .header-inner {
      height: 5rem;   /* 80px – desktop */
    }
  }

  /* ===== LOGO ===== */
  .header-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header-logo img {
    height: 2.75rem;   /* 44px – mobile */
    width: auto;
    display: block;
  }

  @media (min-width: 1024px) {
    .header-logo img {
      height: 3.25rem;   /* 52px – desktop */
    }
  }

  /* ===== DESKTOP NAV ===== */
  .header-nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-nav {
      display: flex;
      flex: 1;
      justify-content: center;
    }

    .header-nav ul {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }

  /* ===== NAV LINKS ===== */
  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #3d322a;
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0.25rem;
    left: 0.75rem;
    right: 0.75rem;
    height: 2px;
    background-color: #ffb730;
    border-radius: 1px;
    transform: scaleX(0);
    transition: transform 0.2s ease;
    transform-origin: left;
  }

  .nav-link:hover {
    color: #2a2018;
    background-color: #f5f3ee;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link--active {
    color: #2a2018;
    font-weight: 700;
  }

  .nav-link--active::after {
    transform: scaleX(1);
  }

  /* ===== HEADER CTA ===== */
  .header-cta {
    display: none;
    font-size: 0.9375rem;
    padding: 0.625rem 1.25rem;
  }

  @media (min-width: 1024px) {
    .header-cta {
      display: inline-flex;
    }
  }

  /* ===== HAMBURGER ===== */
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    padding: 0.5rem;
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .hamburger:hover {
    background-color: #f5f3ee;
  }

  .hamburger-bar {
    display: block;
    width: 1.5rem;
    height: 2px;
    background-color: #2a2018;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }

  /* Animated X state */
  .hamburger[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .hamburger {
      display: none;
    }
  }

  /* ===== MOBILE MENU ===== */
  .mobile-menu {
    position: fixed;
    top: 4.5rem;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #fbf9f4;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem 2rem;
    border-top: 1px solid #e8e2d6;
    animation: slideDown 0.25s ease both;
    z-index: 99;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-menu nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-link {
    display: block;
    padding: 1rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: #3d322a;
    text-decoration: none;
    border-bottom: 1px solid #e8e2d6;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #2a2018;
    padding-left: 0.5rem;
  }

  .mobile-nav-link--active {
    color: #2a2018;
    font-weight: 700;
    border-left: 3px solid #ffb730;
    padding-left: 0.75rem;
  }

  .mobile-menu-footer {
    margin-top: auto;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-menu-address {
    font-size: 0.875rem;
    color: #7d6e5e;
    text-align: center;
    margin: 0;
  }
</style>

<script>
  const toggle   = document.getElementById('menu-toggle')!;
  const menu     = document.getElementById('mobile-menu')!;
  const header   = document.getElementById('site-header')!;

  // Scroll shadow
  window.addEventListener('scroll', () => {
    header.classList.toggle('is-scrolled', window.scrollY > 10);
  }, { passive: true });

  // Toggle mobile menu
  function openMenu() {
    menu.removeAttribute('hidden');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Menü schließen');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Menü öffnen');
    document.body.style.overflow = '';
  }

  toggle.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  // Close on nav link click
  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });

  // Update top offset on resize
  function updateMenuTop() {
    const headerHeight = header.offsetHeight;
    menu.style.top = headerHeight + 'px';
  }

  window.addEventListener('resize', updateMenuTop, { passive: true });
  updateMenuTop();
</script>
