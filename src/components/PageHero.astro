---
/**
 * PageHero – Wiederverwendbare Hero-Section
 *
 * Props:
 *   eyebrow   – Kleiner Text über der Headline
 *   heading   – Haupt-Headline (plain text; für Zeilenumbrüche headingHtml nutzen)
 *   headingHtml – Haupt-Headline als HTML-String (überschreibt heading)
 *   text      – Fließtext unter der Headline
 *   imageSrc  – Importiertes Astro-Bild-Objekt (Mobile-Bild)
 *   imageSrcDesktop – Optionales Desktop-Bild (ab lg: sichtbar)
 *   imageAlt  – Alt-Text für das Hero-Bild
 *   ctaHref   – Ziel-URL des CTA-Buttons (Standard: /kontakt)
 *   ctaLabel  – Beschriftung des CTA-Buttons
 *   headingTag – "h1" (Standard) oder "h2"
 *   imageObjectPosition – CSS object-position Wert (Standard: center 20%)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  headingHtml?: string;
  text: string;
  imageSrc: ImageMetadata | string;
  imageSrcDesktop?: ImageMetadata | string;
  imageAlt: string;
  ctaHref?: string;
  ctaLabel?: string;
  headingTag?: 'h1' | 'h2';
  badgeText?: string;
  imageObjectPosition?: string;
  imageObjectPositionDesktop?: string;
}

const {
  eyebrow = 'Seit über 20 Jahren in Hamburg',
  heading,
  headingHtml,
  text,
  imageSrc,
  imageSrcDesktop,
  imageAlt,
  ctaHref = '/kontakt',
  ctaLabel = 'Jetzt Kontakt aufnehmen',
  headingTag = 'h1',
  badgeText,
  imageObjectPosition = 'center 20%',
  imageObjectPositionDesktop,
} = Astro.props;

const desktopObjPos = imageObjectPositionDesktop || imageObjectPosition;

const HeadingTag = headingTag;

const isImportedImage = typeof imageSrc === 'object';
const isImportedDesktop = typeof imageSrcDesktop === 'object';
---

<!-- =============================================
     PAGE HERO SECTION
     Mobile: Bild oben (full-bleed), Text-Karte überlappt unten
     Desktop: Zweispaltig, Text links, Bild rechts
     ============================================= -->
<section
  class="relative bg-(--color-base) overflow-x-hidden pt-0 pb-12 lg:pt-10 lg:pb-16"
  aria-label="Einführung"
  data-page-hero
>
  <div class="container-page">
    <!-- Grid: Mobile = column-stack, Desktop = 2-column -->
    <div class="flex flex-col lg:grid lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">

      <!-- Bild (oben Mobile, rechts Desktop) -->
      <div class="order-first lg:order-last -mx-4 md:-mx-6 w-[calc(100%+2rem)] md:w-[calc(100%+3rem)] lg:mx-0 lg:w-full lg:col-start-2 relative">
        {/* Mobile-Bild: immer sichtbar auf Mobile, auf Desktop ausgeblendet wenn Desktop-Bild vorhanden */}
        {isImportedImage ? (
          <Image
            src={imageSrc as ImageMetadata}
            alt={imageAlt}
            class:list={[
              "page-hero-image-el w-full h-[320px] sm:h-[400px] md:h-[480px] object-cover rounded-none shadow-none",
              imageSrcDesktop ? "lg:hidden" : "lg:block lg:h-[550px] lg:rounded-[var(--radius-xl)] lg:shadow-[0_12px_40px_rgb(27_34_39/0.08)]",
            ]}
            style={`--obj-pos-m: ${imageObjectPosition}; --obj-pos-d: ${desktopObjPos};`}
            loading="eager"
            decoding="async"
            widths={[400, 700, 900]}
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
        ) : (
          <img
            src={imageSrc as string}
            alt={imageAlt}
            class:list={[
              "page-hero-image-el w-full h-[320px] sm:h-[400px] md:h-[480px] object-cover rounded-none shadow-none",
              imageSrcDesktop ? "lg:hidden" : "lg:block lg:h-[550px] lg:rounded-[var(--radius-xl)] lg:shadow-[0_12px_40px_rgb(27_34_39/0.08)]",
            ]}
            style={`--obj-pos-m: ${imageObjectPosition}; --obj-pos-d: ${desktopObjPos};`}
            loading="eager"
            decoding="async"
          />
        )}

        {/* Desktop-Bild: nur sichtbar auf lg+ */}
        {imageSrcDesktop && (
          isImportedDesktop ? (
            <Image
              src={imageSrcDesktop as ImageMetadata}
              alt={imageAlt}
              class="page-hero-image-el hidden lg:block w-full h-[550px] object-cover rounded-[var(--radius-xl)] shadow-[0_12px_40px_rgb(27_34_39/0.08)]"
              style={`--obj-pos-m: ${imageObjectPosition}; --obj-pos-d: ${desktopObjPos};`}
              loading="eager"
              decoding="async"
              widths={[700, 900, 1200]}
              sizes="50vw"
            />
          ) : (
            <img
              src={imageSrcDesktop as string}
              alt={imageAlt}
              class="page-hero-image-el hidden lg:block w-full h-[550px] object-cover rounded-[var(--radius-xl)] shadow-[0_12px_40px_rgb(27_34_39/0.08)]"
              style={`--obj-pos-m: ${imageObjectPosition}; --obj-pos-d: ${desktopObjPos};`}
              loading="eager"
              decoding="async"
            />
          )
        )}
      </div>

      <!-- Text-Karte (unten Mobile überlappend, links Desktop) -->
      <div class="
        relative z-[2]
        bg-(--color-base) rounded-[var(--radius-lg)] p-8 md:p-10 -mt-20
        flex flex-col gap-4
        lg:bg-transparent lg:rounded-none lg:p-0 lg:mt-0 lg:shadow-none lg:col-start-1 lg:gap-5
      ">
        <!-- Eyebrow -->
        <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-(--color-primary-700)">
          {eyebrow}
        </span>

        <!-- Headline -->
        {headingHtml ? (
          <HeadingTag class="text-[2.25rem] md:text-[2.75rem] leading-[1.2] text-(--color-dark) font-bold m-0" set:html={headingHtml} />
        ) : (
          <HeadingTag class="text-[2.25rem] md:text-[2.75rem] leading-[1.2] text-(--color-dark) font-bold m-0">
            {heading}
          </HeadingTag>
        )}

        <!-- Fließtext -->
        <div class="flex flex-col gap-3 max-w-[55ch]">
          {text.split('\n\n').map((paragraph) => (
            <p class="text-[1.0625rem] leading-[1.75] text-(--color-dark) opacity-90 m-0">
              {paragraph}
            </p>
          ))}
        </div>

        <!-- CTA -->
        <div>
          <a
            href={ctaHref}
            class="
              inline-flex items-center justify-center gap-2
              px-7 py-[0.875rem]
              bg-(--color-primary-500) border-2 border-(--color-primary-500)
              text-dark text-[#1b2227] font-[family-name:var(--font-heading)] text-base font-bold
              rounded-[var(--radius-lg)] no-underline
              shadow-[0_4px_16px_rgb(255_183_48/0.3)]
              transition-all duration-200
              hover:bg-(--color-primary-400) hover:border-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]
              focus-visible:outline-2 focus-visible:outline-(--color-dark) focus-visible:outline-offset-3
              group
            "
          >
            {ctaLabel}
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-1"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Optional Badge (unterhalb des Buttons) -->
        {badgeText && (
          <div class="flex items-center pt-1">
            <div class="inline-flex items-center gap-2 rounded-full border border-(--color-primary-200) bg-(--color-primary-100) px-4 py-1.5 text-[0.875rem] font-semibold text-(--color-primary-800)">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="text-(--color-primary-700)"
              >
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>{badgeText}</span>
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</section>

<style>
  .page-hero-image-el {
    object-position: var(--obj-pos-m);
  }
  @media (min-width: 768px) {
    .page-hero-image-el {
      object-position: var(--obj-pos-d);
    }
  }
</style>
