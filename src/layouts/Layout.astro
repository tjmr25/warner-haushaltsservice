---
// 1. Plus Jakarta Sans – Überschriften
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';

// 2. Inter – Fließtext
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  extraSchema?: Record<string, any>;
}

const {
  title,
  description = 'Warner Haushaltsservice Hamburg: Ihr zuverlässiger Partner für Haushaltshilfe, Alltagsbegleitung und Unterstützung für Pflegebedürftige. Seit über 25 Jahren.',
  ogImage = '/images/og-image.jpg',
  ogType = 'website',
  noindex = false,
  extraSchema,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://warner-hamburg.de';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const fullOgImageUrl = new URL(ogImage, siteUrl).toString();

// Schema.org Structured Data
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#organization`,
      name: 'Warner Haushaltsservice GmbH',
      legalName: 'Warner Haushaltsservice GmbH',
      url: siteUrl,
      logo: `${siteUrl}/images/logo_warner.svg`,
      image: fullOgImageUrl,
      description:
        'Professionelle Haushaltshilfe, Alltagsbegleitung und Entlastungsleistungen für Pflegebedürftige und Privathaushalte in Hamburg. Anerkannt nach HmbPfIEV, Vertrag mit vdek.',
      telephone: '+49-40-29812540',
      email: 'info@warner-hamburg.de',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Haubachstraße 80',
        addressLocality: 'Hamburg',
        postalCode: '22765',
        addressCountry: 'DE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: '53.5592',
        longitude: '9.9416',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '14:00',
        },
      ],
      areaServed: {
        '@type': 'City',
        name: 'Hamburg',
      },
      priceRange: '€€',
      sameAs: ['https://bhdu.de/'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Warner Haushaltsservice',
      description: 'Haushaltshilfe und Alltagsunterstützung in Hamburg',
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      inLanguage: 'de-DE',
    },
    ...(extraSchema ? [extraSchema] : []),
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffb730" />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Warner Haushaltsservice" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:alt" content="Warner Haushaltsservice Hamburg" />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />

    <ClientRouter />
  </head>

  <body>
    <!-- Skip-to-Content (WCAG 2.4.1 Level A) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-5 focus:py-2.5 focus:bg-(--color-primary-500) focus:text-(--color-dark) focus:font-bold focus:rounded-[var(--radius-lg)] focus:shadow-[0_4px_16px_rgb(255_183_48/0.4)] focus:outline-2 focus:outline-offset-2"
    >
      Zum Hauptinhalt springen
    </a>

    <div class="flex min-h-screen flex-col">
      <Header />
      <main id="main-content" class="grow" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Vercel Web Analytics & Speed Insights -->
    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';

      inject();
      injectSpeedInsights();
    </script>
  </body>
</html>
