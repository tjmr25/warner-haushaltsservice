---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Seite nicht gefunden (404) – Warner Haushaltsservice"
  description="Die gewünschte Seite konnte leider nicht gefunden werden. Kehren Sie zur Startseite von Warner Haushaltsservice zurück."
>
  <div class="relative min-h-[calc(100vh-140px)] flex items-center justify-center bg-(--color-base) overflow-hidden py-16 sm:py-24">

    <!-- Dezent schwebende Hintergrund-Elemente -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
      <div class="absolute -top-20 -right-20 w-96 h-96 rounded-full border border-(--color-secondary)/40 opacity-30 animate-[pulse_10s_infinite_ease-in-out]"></div>
      <div class="absolute top-1/2 -left-24 w-80 h-80 rounded-full border border-(--color-secondary)/50 opacity-20"></div>
      <div class="absolute bottom-10 right-20 w-72 h-72 rounded-full border border-(--color-secondary)/30 opacity-25"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(27,34,39,0.035)_1px,transparent_1px)] [background-size:28px_28px]"></div>
    </div>

    <!-- Content Container -->
    <div class="container-page relative z-10 max-w-2xl mx-auto text-center flex flex-col items-center">

      <!-- 404 Zahl als Hero-Element -->
      <div class="relative mb-2 select-none" aria-hidden="true">
        <span class="font-[family-name:var(--font-heading)] text-[6rem] sm:text-[8rem] lg:text-[9.5rem] font-extrabold leading-none tracking-tight text-(--color-primary-500) opacity-90 drop-shadow-sm">
          404
        </span>
      </div>

      <!-- Eyebrow & Headline -->
      <div class="flex flex-col items-center gap-3 mb-6">
        <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold uppercase tracking-[0.1em] text-(--color-primary-700)">
          Fehler 404
        </span>
        <h1 class="m-0 font-[family-name:var(--font-heading)] text-[2rem] sm:text-[2.5rem] font-bold text-(--color-dark) leading-[1.2]">
          Seite nicht gefunden
        </h1>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
      </div>

      <!-- Erklärtext -->
      <p class="m-0 text-[1.0625rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch] mb-8">
        Die von Ihnen aufgerufene Seite existiert leider nicht oder wurde verschoben.
        Nutzen Sie gerne die folgenden Links, um schnell die passende Information zu finden.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto mb-12">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark) bg-(--color-primary-500) border-2 border-(--color-primary-500) rounded-[var(--radius-lg)] no-underline shadow-[0_2px_8px_rgb(255_183_48/0.3)] transition-all duration-200 hover:bg-(--color-primary-400) hover:border-(--color-primary-400) hover:-translate-y-0.5 hover:shadow-[0_4px_16px_rgb(255_183_48/0.4)] active:translate-y-0"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Zur Startseite
        </a>

        <a
          href="/kontakt"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark) bg-white border-2 border-(--color-secondary) rounded-[var(--radius-lg)] no-underline transition-all duration-200 hover:border-(--color-primary-500) hover:bg-(--color-primary-50) hover:-translate-y-0.5 active:translate-y-0"
        >
          Kontakt aufnehmen
        </a>
      </div>

      <!-- Quick Navigation Card -->
      <div class="w-full rounded-[var(--radius-xl)] border border-(--color-secondary) bg-white p-6 sm:p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)]">
        <p class="m-0 text-[0.8125rem] font-bold uppercase tracking-wider text-(--color-dark) opacity-50 mb-4">
          Wichtige Bereiche im Überblick
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
          <a
            href="/pflegebeduerfte"
            class="px-3 py-2.5 rounded-[var(--radius)] bg-(--color-base) text-[0.875rem] font-semibold text-(--color-dark) no-underline border border-(--color-secondary)/60 transition-colors duration-180 hover:bg-(--color-primary-100) hover:text-(--color-primary-900) hover:border-(--color-primary-300)"
          >
            Pflegebedürftige
          </a>
          <a
            href="/privathaushalte"
            class="px-3 py-2.5 rounded-[var(--radius)] bg-(--color-base) text-[0.875rem] font-semibold text-(--color-dark) no-underline border border-(--color-secondary)/60 transition-colors duration-180 hover:bg-(--color-primary-100) hover:text-(--color-primary-900) hover:border-(--color-primary-300)"
          >
            Privathaushalte
          </a>
          <a
            href="/preise"
            class="px-3 py-2.5 rounded-[var(--radius)] bg-(--color-base) text-[0.875rem] font-semibold text-(--color-dark) no-underline border border-(--color-secondary)/60 transition-colors duration-180 hover:bg-(--color-primary-100) hover:text-(--color-primary-900) hover:border-(--color-primary-300)"
          >
            Preise
          </a>
          <a
            href="/ueber-uns"
            class="px-3 py-2.5 rounded-[var(--radius)] bg-(--color-base) text-[0.875rem] font-semibold text-(--color-dark) no-underline border border-(--color-secondary)/60 transition-colors duration-180 hover:bg-(--color-primary-100) hover:text-(--color-primary-900) hover:border-(--color-primary-300)"
          >
            Über uns
          </a>
        </div>
      </div>

      <!-- Telefon-Hinweis -->
      <p class="mt-8 text-[0.9375rem] text-(--color-dark) opacity-70 m-0">
        Telefonische Unterstützung: <a href="tel:+494029812540" class="font-semibold text-(--color-primary-700) hover:underline">040 / 29 81 25 40</a>
      </p>

    </div>
  </div>
</Layout>
