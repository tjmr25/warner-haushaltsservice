---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Impressum | Warner Haushaltsservice Hamburg"
  description="Rechtliche Angaben und Impressum der Warner Haushaltsservice GmbH in Hamburg."
  noindex={true}
>
  <section class="wh-section bg-(--color-base) pt-28 lg:pt-40 pb-16 lg:pb-28">
    <div class="container-page max-w-4xl">
      <!-- Header -->
      <div class="mb-10 flex flex-col gap-3">
        <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-(--color-primary-700)">
          Rechtliches
        </span>
        <h1 class="m-0 font-[family-name:var(--font-heading)] text-[2.25rem] sm:text-[3rem] font-extrabold leading-[1.15] text-(--color-dark)">
          Impressum
        </h1>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
      </div>

      <!-- Content Box -->
      <div class="flex flex-col gap-8 rounded-[var(--radius-xl)] border border-(--color-secondary) bg-white p-6 sm:p-10 shadow-[0_4px_20px_rgb(27_34_39/0.04)]">
        
        <!-- Angaben gemäß § 5 TMG -->
        <div class="flex flex-col gap-2">
          <h2 class="font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) m-0">
            Angaben gemäß § 5 TMG
          </h2>
          <p class="m-0 text-[1rem] leading-[1.75] text-(--color-dark)">
            <strong class="font-semibold">Warner Haushaltsservice GmbH</strong><br />
            Haubachstraße 80<br />
            22765 Hamburg
          </p>
        </div>

        <hr class="border-t border-(--color-secondary)/60 m-0" />

        <!-- Registerangaben -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col gap-1">
            <h3 class="font-[family-name:var(--font-heading)] text-[0.875rem] font-bold uppercase tracking-wider text-(--color-primary-700) m-0">
              Registergericht &amp; Nummer
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.65] text-(--color-dark)">
              Amtsgericht Hamburg<br />
              Registernummer: HRB 75125
            </p>
          </div>

          <div class="flex flex-col gap-1">
            <h3 class="font-[family-name:var(--font-heading)] text-[0.875rem] font-bold uppercase tracking-wider text-(--color-primary-700) m-0">
              Vertreten durch
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.65] text-(--color-dark)">
              Silke Raulf (Geschäftsführerin)
            </p>
          </div>
        </div>

        <hr class="border-t border-(--color-secondary)/60 m-0" />

        <!-- Kontakt -->
        <div class="flex flex-col gap-2">
          <h3 class="font-[family-name:var(--font-heading)] text-[0.875rem] font-bold uppercase tracking-wider text-(--color-primary-700) m-0">
            Kontakt
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-[0.9375rem] text-(--color-dark)">
            <div>
              <span class="opacity-60 block text-[0.8125rem]">Telefon:</span>
              <a href="tel:+494029812540" class="font-semibold text-(--color-dark) hover:text-(--color-primary-700) transition-colors">+49 40 / 29 81 25 40</a>
            </div>
            <div>
              <span class="opacity-60 block text-[0.8125rem]">Telefax:</span>
              <span class="font-semibold">+49 40 / 29 81 25 45</span>
            </div>
            <div>
              <span class="opacity-60 block text-[0.8125rem]">E-Mail:</span>
              <a href="mailto:info@warner-hamburg.de" class="font-semibold text-(--color-primary-700) hover:underline break-all">info@warner-hamburg.de</a>
            </div>
          </div>
        </div>

        <hr class="border-t border-(--color-secondary)/60 m-0" />

        <!-- Umsatzsteuer & Kammer -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col gap-1">
            <h3 class="font-[family-name:var(--font-heading)] text-[0.875rem] font-bold uppercase tracking-wider text-(--color-primary-700) m-0">
              Umsatzsteuer-ID
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.65] text-(--color-dark)">
              Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />
              <strong class="font-semibold">DE206928002</strong>
            </p>
          </div>

          <div class="flex flex-col gap-1">
            <h3 class="font-[family-name:var(--font-heading)] text-[0.875rem] font-bold uppercase tracking-wider text-(--color-primary-700) m-0">
              Zuständige Kammer
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.65] text-(--color-dark)">
              Handelskammer Hamburg<br />
              Adolphsplatz 1<br />
              20457 Hamburg
            </p>
          </div>
        </div>

        <hr class="border-t border-(--color-secondary)/60 m-0" />

        <!-- Berufshaftpflichtversicherung -->
        <div class="flex flex-col gap-2">
          <h3 class="font-[family-name:var(--font-heading)] text-[0.875rem] font-bold uppercase tracking-wider text-(--color-primary-700) m-0">
            Angaben zur Berufshaftpflichtversicherung
          </h3>
          <p class="m-0 text-[0.9375rem] leading-[1.65] text-(--color-dark)">
            <strong class="font-semibold">Name und Sitz des Versicherers:</strong><br />
            AXA Versicherung AG<br />
            51171 Köln
          </p>
          <p class="m-0 text-[0.9375rem] leading-[1.65] text-(--color-dark)">
            <strong class="font-semibold">Geltungsraum der Versicherung:</strong> Deutschland
          </p>
        </div>

        <hr class="border-t border-(--color-secondary)/60 m-0" />

        <!-- Streitschlichtung -->
        <div class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <h3 class="font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark) m-0">
              EU-Streitschlichtung
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
              Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
              <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer" class="text-(--color-primary-700) font-semibold underline hover:text-(--color-primary-600) break-all">
                https://ec.europa.eu/consumers/odr/
              </a>.<br />
              Unsere E-Mail-Adresse finden Sie oben im Impressum.
            </p>
          </div>

          <div class="flex flex-col gap-1.5">
            <h3 class="font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark) m-0">
              Verbraucherstreitbeilegung / Universalschlichtungsstelle
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
              Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
            </p>
          </div>

          <p class="m-0 text-[0.8125rem] text-(--color-dark) opacity-50 pt-2">
            Quelle: eRecht24
          </p>
        </div>

      </div>
    </div>
  </section>
</Layout>
