---
import Layout from '../layouts/Layout.astro';

const stats = [
  { value: '100+', label: 'Mitarbeiterinnen' },
  { value: '700+', label: 'Betreute Haushalte' },
  { value: '20+',  label: 'Jahre Erfahrung'   },
];

const reasons = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>`,
    title: 'Qualität',
    text: 'Höchste Standards sind unser Versprechen. Mit einem internen Schulungssystem und über 20 Jahren Erfahrung bieten wir sorgfältige Arbeit und erstklassigen Service.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Flexibilität',
    text: 'Wir passen uns Ihrem Zeitplan an. Mit maßgeschneiderten Lösungen stehen wir Ihnen zur Verfügung, wann immer Sie uns brauchen.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Sicherheit',
    text: 'Ihre Sicherheit ist unsere Priorität – Arbeitsschutz, Haftpflichtversicherung für alle Mitarbeiterinnen in Ihrem Haushalt sowie sorgfältiger Datenschutz.',
  },
];

const recognitions = [
  'Abrechnung über die Pflegekasse möglich',
  'Geschulte Mitarbeiterinnen & Erste-Hilfe-Kurs',
  'Individuelle und respektvolle Betreuung',
];
---

<Layout
  title="Für ein glänzendes Zuhause"
  description="Warner Haushaltsservice Hamburg – Ihr zuverlässiger Partner für professionelle Haushaltshilfe und Alltagsunterstützung für Pflegebedürftige. Von der Stadt Hamburg anerkannt."
>

  <!-- ===== HERO ===== -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container-content hero-inner">

      <!-- Text Side -->
      <div class="hero-text">
        <p class="section-label">Seit über 20 Jahren in Hamburg</p>
        <h1 id="hero-heading" class="hero-heading">
          Für ein glänzendes<br />
          <span class="hero-highlight">Zuhause</span>
        </h1>
        <p class="hero-sub">
          Willkommen beim Warner Haushaltsservice! Seit über zwölf Jahren sind
          wir Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen –
          mit Hingabe, damit Sie sich in Ihren eigenen vier Wänden wohl fühlen.
        </p>

        <!-- Recognition Badges -->
        <ul class="recognition-list" role="list">
          {recognitions.map(item => (
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <!-- CTAs -->
        <div class="hero-ctas">
          <a href="/kontakt" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            Beratung anfordern
          </a>
          <a href="tel:+4940298125400" class="btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
            </svg>
            040 / 29 81 25 40
          </a>
        </div>
      </div>

      <!-- Image Side -->
      <div class="hero-image-wrap" aria-hidden="true">
        <div class="hero-image-frame">
          <img
            src="/images/hero-home.jpg"
            alt="Freundliche Haushaltshilfe bei der Arbeit in einem gepflegten Hamburger Zuhause"
            width="620"
            height="720"
            loading="eager"
            fetchpriority="high"
            class="hero-img"
          />
          <!-- Floating trust card -->
          <div class="hero-trust-card" aria-hidden="true">
            <div class="trust-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div>
              <p class="trust-title">Von Hamburg anerkannt</p>
              <p class="trust-sub">Pflegekasse-Abrechnung möglich</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Stats Bar -->
    <div class="stats-bar">
      <div class="container-content stats-inner">
        {stats.map(stat => (
          <div class="stat-item">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== WHY US ===== -->
  <section class="section-padding bg-warm-light" aria-labelledby="why-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">Warum Warner?</p>
        <h2 id="why-heading">Warum wir?</h2>
        <div class="accent-divider"></div>
        <p class="section-intro">
          Mit einem Team von über 100 engagierten Mitarbeiterinnen betreuen wir
          mehr als 700 Haushalte und unterstützen Pflegebedürftige dabei, ein
          selbstbestimmtes Leben zu führen. Bei uns stehen Ihre individuellen
          Bedürfnisse im Mittelpunkt.
        </p>
      </header>

      <div class="reasons-grid">
        {reasons.map(reason => (
          <article class="card reason-card">
            <div class="reason-icon" set:html={reason.icon}></div>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TWO SERVICES TEASERS ===== -->
  <section class="section-padding bg-warm-mid" aria-labelledby="services-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">Unsere Angebote</p>
        <h2 id="services-heading">Wie können wir Ihnen helfen?</h2>
        <div class="accent-divider"></div>
      </header>

      <div class="services-grid">

        <!-- Service 1: Privat -->
        <article class="service-card service-card--private">
          <div class="service-card-image">
            <img
              src="/images/service-privat.jpg"
              alt="Gepflegtes, sauberes Wohnzimmer"
              width="580"
              height="340"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <p class="section-label">Für Privatkunden</p>
            <h3>Haushaltshilfe für<br />Privathaushalte</h3>
            <p>
              Familien, Berufstätige und Senioren – wir entlasten Sie im Alltag
              mit professioneller Reinigung, Wäschepflege und Ordnung. Damit Sie
              mehr Zeit für das Wesentliche haben.
            </p>
            <ul class="check-list" role="list">
              <li>Reinigung & Aufräumen</li>
              <li>Wäschepflege & Bügeln</li>
              <li>Maßgeschneiderte Zeitpakete</li>
            </ul>
            <a href="/privathaushalte" class="btn-primary" style="margin-top: 1.5rem;">
              Mehr erfahren
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        </article>

        <!-- Service 2: Pflegebedürftige -->
        <article class="service-card service-card--pflege">
          <div class="service-card-image">
            <img
              src="/images/service-pflege.jpg"
              alt="Respektvoller Umgang mit einer älteren Dame"
              width="580"
              height="340"
              loading="lazy"
            />
          </div>
          <div class="service-card-body">
            <p class="section-label" style="color: #7d6e5e;">Für Pflegebedürftige</p>
            <h3>Alltagsunterstützung –<br />über Pflegekasse abrechenbar</h3>
            <p>
              Als von der Stadt Hamburg anerkanntes Unternehmen rechnen wir
              unsere Leistungen direkt mit der Pflegekasse ab. Für Pflegegrade
              1–5 – ohne Aufwand für Sie.
            </p>
            <ul class="check-list" role="list">
              <li>Pflegekasse übernimmt die Kosten</li>
              <li>Keine Vorausleistung nötig</li>
              <li>Geschulte & zertifizierte Mitarbeiterinnen</li>
            </ul>
            <a href="/pflegebeduerfte" class="btn-primary" style="margin-top: 1.5rem; background-color: #2a2018; border-color: #2a2018; color: #fbf9f4;">
              Zur Pflegekassen-Info
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIAL ===== -->
  <section class="section-padding testimonial-section" aria-labelledby="testimonial-heading">
    <div class="container-content">
      <p class="section-label" style="text-align: center;">Das sagen unsere Kunden</p>
      <h2 id="testimonial-heading" class="testimonial-title">Vertrauen, das spricht</h2>

      <figure class="testimonial-card">
        <blockquote>
          <p>
            „Seit Jahren zuverlässige Reinigung sowie freundliche und persönliche
            Kundenbetreuung. Insbesondere auf einem Markt, in dem es viele schwarze
            Schafe gibt, überzeugt der Haushaltsservice mit qualitativ hochwertiger
            Arbeit und einer professionellen Betreuung. Sehr weiter zu empfehlen!"
          </p>
        </blockquote>
        <figcaption>
          <span class="testimonial-stars" aria-label="5 von 5 Sternen">★★★★★</span>
          <cite>M. S. <span>– Kunde</span></cite>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== MEMBERSHIPS ===== -->
  <section class="section-padding bg-warm-light" aria-labelledby="member-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">Vertrauen & Qualität</p>
        <h2 id="member-heading">Mitgliedschaften & Partner</h2>
        <div class="accent-divider"></div>
      </header>

      <div class="membership-grid">
        <div class="membership-item">
          <div class="membership-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
            </svg>
          </div>
          <div>
            <h3>BHDU</h3>
            <p>Mitglied im Bundesverband haushaltsnaher Dienstleistungs-Unternehmen</p>
          </div>
        </div>

        <div class="membership-item">
          <div class="membership-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div>
            <h3>NOVA Raumpflege</h3>
            <p>Unser Partnerunternehmen für Gebäude- und Glasreinigung</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FINAL CTA ===== -->
  <section class="final-cta" aria-labelledby="cta-heading">
    <div class="container-content final-cta-inner">
      <h2 id="cta-heading">Bereit, den ersten Schritt zu machen?</h2>
      <p>
        Kontaktieren Sie uns für ein unverbindliches Erstgespräch. Wir beraten
        Sie gerne persönlich und finden gemeinsam die passende Lösung für
        Ihren Haushalt.
      </p>
      <div class="final-cta-buttons">
        <a href="/kontakt" class="btn-primary">
          Jetzt Beratung anfordern
        </a>
        <a href="tel:+4940298125400" class="final-cta-tel">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/>
          </svg>
          040 / 29 81 25 40
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== GLOBAL PAGE OFFSET for fixed header ===== */
  main {
    padding-top: 4.5rem; /* matches mobile header height */
  }

  @media (min-width: 1024px) {
    main {
      padding-top: 5rem; /* matches desktop header height */
    }
  }

  /* ===== HERO ===== */
  .hero {
    background-color: #fbf9f4;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-top: 3.5rem;
    padding-bottom: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-top: 5rem;
      padding-bottom: 4rem;
    }
  }

  /* Hero Text */
  .hero-text {
    max-width: 540px;
  }

  .hero-heading {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    color: #2a2018;
    margin: 0 0 1.25rem;
    line-height: 1.15;
  }

  .hero-highlight {
    color: #ffb730;
    font-style: italic;
    font-family: "Newsreader", Georgia, serif;
  }

  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #3d322a;
    margin: 0 0 1.75rem;
    max-width: 480px;
  }

  /* Recognition List */
  .recognition-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .recognition-list li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #3d322a;
  }

  .recognition-list svg {
    flex-shrink: 0;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* Hero Image */
  .hero-image-wrap {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-image-wrap {
      display: block;
    }
  }

  .hero-image-frame {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    max-width: 540px;
    margin: 0 auto;
  }

  .hero-image-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 183, 48, 0.08) 0%,
      transparent 60%
    );
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
  }

  .hero-img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }

  @media (min-width: 1024px) {
    .hero-img {
      height: 520px;
    }
  }

  /* Trust card floating */
  .hero-trust-card {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: rgba(251, 249, 244, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid #e8e2d6;
    border-radius: 0.875rem;
    padding: 0.875rem 1.125rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 2;
    box-shadow: 0 4px 20px rgba(42, 32, 24, 0.1);
  }

  .trust-icon {
    width: 2.5rem;
    height: 2.5rem;
    background-color: #fff9eb;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .trust-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: #2a2018;
    margin: 0 0 0.125rem;
  }

  .trust-sub {
    font-size: 0.75rem;
    color: #7d6e5e;
    margin: 0;
  }

  /* ===== STATS BAR ===== */
  .stats-bar {
    background-color: #2a2018;
    padding: 2rem 0;
  }

  .stats-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem 3rem;
  }

  @media (min-width: 640px) {
    .stats-inner {
      justify-content: space-around;
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #ffb730;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #b8ab9a;
    font-weight: 500;
  }

  /* ===== SECTION HEADER ===== */
  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .section-header h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    margin: 0;
  }

  .section-header .accent-divider {
    margin: 1rem auto;
  }

  .section-intro {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #5b3824;
    margin: 0;
  }

  /* ===== REASONS GRID ===== */
  .reasons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .reasons-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .reasons-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .reason-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .reason-icon {
    width: 3rem;
    height: 3rem;
    background-color: #fff9eb;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffb730;
    flex-shrink: 0;
  }

  .reason-card h3 {
    font-size: 1.1875rem;
    margin: 0;
  }

  .reason-card p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #5b3824;
    margin: 0;
  }

  /* ===== SERVICES GRID ===== */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-card {
    background-color: #fbf9f4;
    border-radius: 1.25rem;
    overflow: hidden;
    border: 1px solid #e8e2d6;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .service-card:hover {
    box-shadow: 0 12px 40px rgba(42, 32, 24, 0.1);
    transform: translateY(-4px);
  }

  .service-card-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .service-card-image {
      height: 260px;
    }
  }

  .service-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .service-card:hover .service-card-image img {
    transform: scale(1.03);
  }

  .service-card--pflege .service-card-image img {
    filter: brightness(0.97);
  }

  .service-card-body {
    padding: 1.75rem;
  }

  .service-card-body h3 {
    font-size: 1.3125rem;
    margin: 0.5rem 0 0.875rem;
  }

  .service-card-body p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #5b3824;
    margin: 0 0 1.25rem;
  }

  /* ===== TESTIMONIAL ===== */
  .testimonial-section {
    background: linear-gradient(135deg, #ecd8b5 0%, #f5f3ee 60%);
  }

  .testimonial-title {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    text-align: center;
