---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Warner Haushaltsservice – Für ein glänzendes Zuhause in Hamburg"
  description="Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen und Seniorenbetreuung in Hamburg. Seit über 20 Jahren für Sie da."
>
  <!-- =============================================
       HERO SECTION
       Mobile: Bild oben (full-bleed), Text-Karte überlappt unten
       Desktop: Zweispaltig, Text links, Bild rechts
       ============================================= -->
  <section
    class="hero-gradient relative bg-(--color-base-alt) overflow-x-hidden pb-12 md:pt-8 md:pb-16 lg:pt-[7.5rem] lg:pb-20"
    aria-label="Einführung"
  >
    <div class="container-page">
      <!-- Grid: Mobile = column-stack, Desktop = 2-column -->
      <div class="flex flex-col lg:grid lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16">

        <!-- Bild (oben Mobile, rechts Desktop) -->
        <div class="order-first lg:order-last -mx-4 md:-mx-6 w-[calc(100%+2rem)] md:w-[calc(100%+3rem)] lg:mx-0 lg:w-full lg:col-start-2">
          <img
            src="/images/hero_startseite.png"
            alt="Ein aufgeräumtes und sauberes Wohnzimmer in Hamburg mit einer Haushaltshilfe dezent im Hintergrund"
            width="600"
            height="600"
            loading="eager"
            fetchpriority="high"
            class="w-full h-[450px] object-cover block lg:h-[600px] lg:rounded-[var(--radius-lg)] lg:shadow-[var(--shadow-warm-md)]"
          />
        </div>

        <!-- Text-Karte (unten Mobile überlappend, links Desktop) -->
        <div class="
          relative z-[2]
          bg-(--color-base-alt) rounded-[var(--radius-lg)] p-8 md:p-10 -mt-20
          flex flex-col gap-4
          lg:bg-transparent lg:rounded-none lg:p-0 lg:mt-0 lg:shadow-none lg:col-start-1 lg:gap-5
        ">
          <!-- Eyebrow -->
          <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-(--color-primary-700)">
            Seit über 20 Jahren in Hamburg
          </span>

          <!-- H1 -->
          <h1 class="text-[2.25rem] md:text-[2.75rem] leading-[1.2] text-(--color-dark) font-bold m-0">
            Für ein glänzendes <br class="hidden lg:block" />
            <span>Zuhause</span>
          </h1>

          <!-- Fließtext -->
          <p class="text-[1.0625rem] leading-[1.75] text-(--color-dark) opacity-90 m-0 max-w-[55ch]">
            Willkommen beim Warner Haushaltsservice! Seit über zwölf Jahren sind
            wir Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen –
            mit Hingabe, damit Sie sich in Ihren eigenen vier Wänden wohl
            fühlen.
          </p>

          <!-- CTA -->
          <div>
            <a
              href="/kontakt"
              class="
                inline-flex items-center justify-center gap-2
                w-full md:w-auto
                px-7 py-[0.875rem]
                bg-(--color-primary-500) border-2 border-(--color-primary-500)
                text-(--color-dark) font-[family-name:var(--font-heading)] text-base font-bold
                rounded-[var(--radius)] no-underline
                shadow-[0_4px_12px_rgb(255_183_48/0.25)]
                transition-all duration-[250ms]
                hover:bg-transparent hover:text-(--color-primary-800) hover:shadow-none
                focus-visible:outline-2 focus-visible:outline-(--color-dark) focus-visible:outline-offset-3
                group
              "
            >
              Jetzt Kontakt aufnehmen
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="transition-transform duration-200 group-hover:translate-x-1"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- =============================================
           STATS SECTION (dunkler Hintergrund)
           ============================================= -->
      <section
        class="wh-section bg-(--color-dark) overflow-hidden -mx-4 md:-mx-6 lg:mx-0 w-[calc(100%+2rem)] md:w-[calc(100%+3rem)] lg:w-full mt-12 lg:mt-16"
        aria-label="Erfolge und Zahlen"
      >
        <div class="container-page">
          <!-- Flex-Layout: Mobile = column/gestaffelt, Tablet+ = row -->
          <div class="flex flex-col gap-16 md:flex-row md:justify-between md:gap-8 lg:max-w-[1100px] lg:mx-auto lg:gap-14">

            <!-- Stat 1 -->
            <div class="stat-block relative w-full max-w-[290px] min-h-[140px] flex items-center self-start border-t border-l border-[rgba(235,225,208,0.15)] rounded-tl-[var(--radius)] p-4 md:flex-1 md:self-auto md:max-w-none md:min-h-[170px] md:p-[2rem_1.5rem_1.5rem_2rem]">
              <div class="stat-giant-bg" aria-hidden="true">100</div>
              <div class="relative z-[2] flex flex-col items-start pointer-events-none">
                <span class="font-[family-name:var(--font-heading)] text-[2.5rem] lg:text-[3rem] font-extrabold text-(--color-primary-500) leading-none tracking-[-0.02em] mb-[0.35rem]">100+</span>
                <span class="font-[family-name:var(--font-body)] text-[0.875rem] lg:text-[0.9375rem] font-bold text-(--color-base) uppercase tracking-[0.08em] leading-[1.3] opacity-95">Mitarbeiterinnen</span>
              </div>
            </div>

            <!-- Stat 2 -->
            <div class="stat-block relative w-full max-w-[290px] min-h-[140px] flex items-center self-end ml-0 border-t border-l border-[rgba(235,225,208,0.15)] rounded-tl-[var(--radius)] p-4 md:flex-1 md:self-auto md:max-w-none md:min-h-[170px] md:p-[2rem_1.5rem_1.5rem_2rem]">
              <div class="stat-giant-bg" aria-hidden="true">700</div>
              <div class="relative z-[2] flex flex-col items-start pointer-events-none">
                <span class="font-[family-name:var(--font-heading)] text-[2.5rem] lg:text-[3rem] font-extrabold text-(--color-primary-500) leading-none tracking-[-0.02em] mb-[0.35rem]">700+</span>
                <span class="font-[family-name:var(--font-body)] text-[0.875rem] lg:text-[0.9375rem] font-bold text-(--color-base) uppercase tracking-[0.08em] leading-[1.3] opacity-95">betreute Haushalte</span>
              </div>
            </div>

            <!-- Stat 3 -->
            <div class="stat-block relative w-full max-w-[290px] min-h-[140px] flex items-center self-start ml-[8%] border-t border-l border-[rgba(235,225,208,0.15)] rounded-tl-[var(--radius)] p-4 md:flex-1 md:self-auto md:max-w-none md:min-h-[170px] md:ml-0 md:p-[2rem_1.5rem_1.5rem_2rem]">
              <div class="stat-giant-bg" aria-hidden="true">20</div>
              <div class="relative z-[2] flex flex-col items-start pointer-events-none">
                <span class="font-[family-name:var(--font-heading)] text-[2.5rem] lg:text-[3rem] font-extrabold text-(--color-primary-500) leading-none tracking-[-0.02em] mb-[0.35rem]">20+</span>
                <span class="font-[family-name:var(--font-body)] text-[0.875rem] lg:text-[0.9375rem] font-bold text-(--color-base) uppercase tracking-[0.08em] leading-[1.3] opacity-95">Jahre Erfahrung</span>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </section>
</Layout>
