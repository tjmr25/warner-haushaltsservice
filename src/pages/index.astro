---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Warner Haushaltsservice – Für ein glänzendes Zuhause in Hamburg"
  description="Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen und Seniorenbetreuung in Hamburg. Seit über 20 Jahren für Sie da."
>
  <!-- Hero Section -->
  <section class="wh-hero" aria-label="Einführung">
    <div class="container-page">
      <div class="wh-hero__grid">
        
        <!-- Bild-Inhalt (Oben auf Mobile, rechts auf Desktop) -->
        <div class="wh-hero__image-wrapper">
          <img 
            src="/images/housekeeper_home.png" 
            alt="Freundliche Haushaltshilfe des Warner Haushaltsservice lächelt beim Wischen eines Holztischs in einer hellen Hamburger Wohnung" 
            width="600"
            height="600"
            class="wh-hero__img"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Text-Inhalt (Unten auf Mobile in weißer Karte, links auf Desktop) -->
        <div class="wh-hero__content">
          <span class="wh-hero__eyebrow">Seit über 20 Jahren in Hamburg</span>
          
          <h1 class="wh-hero__title">
            Für ein glänzendes <br class="desktop-only" />
            <span>Zuhause</span>
          </h1>

          <p class="wh-hero__text">
            Willkommen beim Warner Haushaltsservice! Seit über zwölf Jahren sind wir Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen – mit Hingabe, damit Sie sich in Ihren eigenen vier Wänden wohl fühlen.
          </p>
          
          <div class="wh-hero__actions">
            <a href="/kontakt" class="wh-btn-primary">
              Jetzt Kontakt aufnehmen
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="wh-btn-icon" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

  </section>

  <!-- Stats Section -->
  <section class="wh-stats" aria-label="Statistiken und Erfolge">
    <div class="container-page">
      <div class="wh-stats__cluster">
        
        <!-- Stat Bubble 1 -->
        <div class="wh-stats__bubble wh-stats__bubble--1">
          <span class="wh-stats__number">100+</span>
          <span class="wh-stats__label">Mitarbeiter-<br/>innen</span>
        </div>

        <!-- Stat Bubble 2 -->
        <div class="wh-stats__bubble wh-stats__bubble--2">
          <span class="wh-stats__number">700+</span>
          <span class="wh-stats__label">betreute<br/>Haushalte</span>
        </div>

        <!-- Stat Bubble 3 -->
        <div class="wh-stats__bubble wh-stats__bubble--3">
          <span class="wh-stats__number">20+</span>
          <span class="wh-stats__label">Jahre<br/>Erfahrung</span>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  /* =========================================
     HERO SECTION
     ========================================= */
  .wh-hero {
    padding-top: 0; /* Kein Padding oben auf Mobile, da das Bild randlos abschließen soll */
    padding-bottom: 3rem;
    background-color: var(--color-base-alt);
  }

  /* Grid Layout (Mobile First: Einspaltig stapelnd, Bild oben) */
  .wh-hero__grid {
    display: flex;
    flex-direction: column;
  }

  /* Bild-Container & Bild */
  .wh-hero__image-wrapper {
    /* Ausbruch aus dem 1.5rem Container-Padding auf Mobile für volle Breite */
    margin-inline: -1.5rem;
    width: calc(100% + 3rem);
  }

  .wh-hero__img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3; /* Etwas breiter auf Mobile, damit es nicht zu hoch ist */
    display: block;
  }

  /* Text-Container (Abgerundetes Rechteck auf Mobile) */
  .wh-hero__content {
    background-color: var(--color-base);
    border-radius: var(--radius-lg); /* Unser Standard-Radius (8px) */
    padding: 3.5rem 1.5rem; /* Mehr Padding oben und unten */
    margin-top: -3.5rem; /* Zieht das Rechteck nach oben, um das Bild zu überlappen */
    position: relative;
    z-index: 2;
    box-shadow: 0 8px 30px rgb(27 34 39 / 0.08); /* Feiner, wertiger Schatten */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Eyebrow / Dachzeile */
  .wh-hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-700);
  }

  /* Hauptüberschrift (H1) */
  .wh-hero__title {
    font-size: 2.25rem; /* Große Schrift auf Mobile */
    line-height: 1.2;
    color: var(--color-dark);
    font-weight: 700;
    margin: 0;
  }

  /* Textabschnitt */
  .wh-hero__text {
    font-size: 1.0625rem; /* 17px für hervorragende Lesbarkeit */
    line-height: 1.75;
    color: var(--color-dark);
    opacity: 0.9;
    margin: 0;
    max-width: 55ch;
  }

  /* CTA Button */
  .wh-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%; /* Volle Breite auf Mobile */
    padding: 0.875rem 1.75rem;
    background-color: var(--color-primary-500);
    border: 2px solid var(--color-primary-500);
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(255 183 48 / 0.25);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .wh-btn-primary:hover {
    background-color: transparent;
    border-color: var(--color-primary-500);
    color: var(--color-primary-800);
    box-shadow: none;
  }

  .wh-btn-icon {
    transition: transform 0.2s ease;
  }

  .wh-btn-primary:hover .wh-btn-icon {
    transform: translateX(4px);
  }

  .wh-btn-primary:focus-visible {
    outline: 2px solid var(--color-dark);
    outline-offset: 3px;
  }

  /* Hilfsklassen */
  .desktop-only {
    display: none;
  }

  /* =========================================
     TABLET & DESKTOP BREAKPOINTS
     ========================================= */
  @media (min-width: 768px) {
    .wh-hero {
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
    
    .wh-hero__title {
      font-size: 2.75rem;
    }

    .wh-hero__content {
      padding: 2.5rem;
      margin-top: -5rem;
    }

    .wh-btn-primary {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .desktop-only {
      display: block;
    }

    .wh-hero {
      padding-top: 4rem;
      padding-bottom: 5rem;
    }

    /* Zweispaltiges Grid auf Desktop, Text links, Bild rechts */
    .wh-hero__grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
      gap: 4rem;
    }

    /* Deaktiviert Karten-Stile von Mobile in der Desktop-Ansicht */
    .wh-hero__content {
      background-color: transparent;
      border-radius: 0;
      padding: 0;
      margin-top: 0;
      box-shadow: none;
      grid-column: 1;
      gap: 1.25rem;
    }

    .wh-hero__image-wrapper {
      margin-inline: 0;
      width: 100%;
      grid-column: 2;
    }

    .wh-hero__img {
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-lg); /* Abgerundete Ecken auf Desktop */
      box-shadow: var(--shadow-warm-md);
    }
  }

  /* ==============  /* =========================================
     STATS SECTION
     ========================================= */
  .wh-stats {
    padding-top: 3rem;
    padding-bottom: 5rem;
    background-color: var(--color-base-alt); /* Gleicher Sektions-Hintergrund wie Hero */
    overflow: hidden;
  }

  /* Relativer Container für das überlappende Mobile-Cluster */
  .wh-stats__cluster {
    position: relative;
    /* Ausbruch aus dem 1.5rem Container-Padding auf Mobile für volle Breite */
    margin-inline: -1.5rem;
    width: calc(100% + 3rem);
    height: 340px; /* Kompakter, da Blasen enger zusammenliegen */
    margin-top: 1rem;
  }

  /* Einzelne Blase (Bubble) */
  .wh-stats__bubble {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 10px 25px rgb(27 34 39 / 0.08);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    padding: 1rem;
    width: 150px;
    height: 150px;
    box-sizing: border-box;
  }

  /* Asymmetrische, organische Formen (Blobs) & Positionen */
  .wh-stats__bubble--1 {
    background-color: var(--color-primary-100);
    border-radius: 50%; /* Reines Rund für absolute Formtreue */
    left: 4%;
    top: 10px;
    z-index: 2;
  }

  .wh-stats__bubble--2 {
    background-color: var(--color-secondary);
    border-radius: 50%;
    width: 165px;
    height: 165px;
    right: 4%;
    top: 40px;
    z-index: 1;
  }

  .wh-stats__bubble--3 {
    background-color: var(--color-primary-200);
    border-radius: 50%;
    width: 155px;
    height: 155px;
    left: 24%;
    bottom: 10px;
    z-index: 3;
  }

  /* Interaktiver Schwebe-Effekt */
  .wh-stats__bubble:hover {
    transform: scale(1.08) rotate(3deg);
    z-index: 10;
  }

  /* Stat-Zahlen */
  .wh-stats__number {
    font-family: var(--font-heading);
    font-size: 2.125rem; /* Größer (34px) */
    font-weight: 800;
    color: var(--color-dark);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
  }

  /* Stat-Labels (Direkt in den Blasen) */
  .wh-stats__label {
    font-family: var(--font-body);
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-dark);
    opacity: 0.8;
    line-height: 1.3;
  }

  /* =========================================
     TABLET & DESKTOP BREAKPOINTS FOR STATS
     ========================================= */
  @media (min-width: 768px) {
    /* Auf Tablet/Desktop lösen wir das absolute Layout auf */
    .wh-stats__cluster {
      display: flex;
      flex-direction: row;
      justify-content: space-around;
      align-items: center;
      height: auto;
      max-width: 800px;
      gap: 2rem;
    }

    .wh-stats__bubble {
      position: relative;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      bottom: auto !important;
      transform: none;
      width: 170px;
      height: 170px;
    }

    /* Leichte visuelle Versetzung (staggered) auf größeren Bildschirmen */
    .wh-stats__bubble--1 {
      transform: translateY(-10px);
    }
    
    .wh-stats__bubble--2 {
      transform: translateY(15px);
    }

    .wh-stats__bubble--3 {
      transform: translateY(-5px);
    }

    .wh-stats__bubble:hover {
      transform: scale(1.08) rotate(3deg) !important;
    }

    .wh-stats__number {
      font-size: 2.25rem; /* 36px */
    }

    .wh-stats__label {
      font-size: 0.8125rem; /* 13px */
    }
  }

  @media (min-width: 1024px) {
    .wh-stats {
      padding-top: 6rem;
      padding-bottom: 7rem;
    }

    .wh-stats__cluster {
      justify-content: space-between;
      max-width: 960px;
    }

    .wh-stats__bubble {
      width: 200px;
      height: 200px;
      padding: 1.5rem;
    }

    .wh-stats__number {
      font-size: 2.75rem; /* 44px */
    }

    .wh-stats__label {
      font-size: 0.875rem; /* 14px */
    }
  }
</style>
