---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Warner Haushaltsservice – Für ein glänzendes Zuhause in Hamburg"
  description="Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen und Seniorenbetreuung in Hamburg. Seit über 20 Jahren für Sie da."
>
  <!-- Hero Section -->
  <section class="wh-hero" aria-label="Einführung">
    <div class="container-page">
      <div class="wh-hero__grid">
        
        <!-- Bild-Inhalt (Oben auf Mobile, rechts auf Desktop) -->
        <div class="wh-hero__image-wrapper">
          <img 
            src="/images/housekeeper_home.png" 
            alt="Freundliche Haushaltshilfe des Warner Haushaltsservice lächelt beim Wischen eines Holztischs in einer hellen Hamburger Wohnung" 
            width="600"
            height="600"
            class="wh-hero__img"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Text-Inhalt (Unten auf Mobile in weißer Karte, links auf Desktop) -->
        <div class="wh-hero__content">
          <span class="wh-hero__eyebrow">Seit über 20 Jahren in Hamburg</span>
          
          <h1 class="wh-hero__title">
            Für ein glänzendes <br class="desktop-only" />
            <span>Zuhause</span>
          </h1>

          <p class="wh-hero__text">
            Willkommen beim Warner Haushaltsservice! Seit über zwölf Jahren sind wir Ihr zuverlässiger Partner für haushaltsnahe Dienstleistungen – mit Hingabe, damit Sie sich in Ihren eigenen vier Wänden wohl fühlen.
          </p>
          
          <div class="wh-hero__actions">
            <a href="/kontakt" class="wh-btn-primary">
              Jetzt Kontakt aufnehmen
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="wh-btn-icon" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

  </section>

  <!-- Stats Section -->
  <section class="wh-stats" aria-label="Erfolge und Zahlen">
    <div class="container-page">
      <div class="wh-stats__layout">
        
        <!-- Stat Block 1 -->
        <div class="wh-stats__block wh-stats__block--1">
          <div class="wh-stats__giant-bg" aria-hidden="true">100</div>
          <div class="wh-stats__fg">
            <span class="wh-stats__number">100+</span>
            <span class="wh-stats__label">Mitarbeiterinnen</span>
          </div>
        </div>

        <!-- Stat Block 2 -->
        <div class="wh-stats__block wh-stats__block--2">
          <div class="wh-stats__giant-bg" aria-hidden="true">700</div>
          <div class="wh-stats__fg">
            <span class="wh-stats__number">700+</span>
            <span class="wh-stats__label">betreute Haushalte</span>
          </div>
        </div>

        <!-- Stat Block 3 -->
        <div class="wh-stats__block wh-stats__block--3">
          <div class="wh-stats__giant-bg" aria-hidden="true">20</div>
          <div class="wh-stats__fg">
            <span class="wh-stats__number">20+</span>
            <span class="wh-stats__label">Jahre Erfahrung</span>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  /* =========================================
     HERO SECTION
     ========================================= */
  .wh-hero {
    padding-top: 0; /* Kein Padding oben auf Mobile, da das Bild randlos abschließen soll */
    padding-bottom: 3rem;
    background-color: var(--color-base-alt);
    overflow-x: hidden; /* Verhindert horizontalen Scrollbalken durch das breite Bild */
  }

  /* Grid Layout (Mobile First: Einspaltig stapelnd, Bild oben) */
  .wh-hero__grid {
    display: flex;
    flex-direction: column;
  }

  /* Bild-Container & Bild */
  .wh-hero__image-wrapper {
    /* Ausbruch aus dem 1.5rem Container-Padding auf Mobile für volle Breite */
    margin-inline: -1.5rem;
    width: calc(100% + 3rem);
  }

  .wh-hero__img {
    width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3; /* Etwas breiter auf Mobile, damit es nicht zu hoch ist */
    display: block;
  }

  /* Text-Container (Abgerundetes Rechteck auf Mobile) */
  .wh-hero__content {
    background-color: var(--color-base-alt);
    border-radius: var(--radius-lg); /* Unser Standard-Radius (8px) */
    padding: 3.5rem 1.5rem; /* Mehr Padding oben und unten */
    margin-top: -3.5rem; /* Zieht das Rechteck nach oben, um das Bild zu überlappen */
    position: relative;
    z-index: 2;
    box-shadow: 0 8px 30px rgb(27 34 39 / 0.08); /* Feiner, wertiger Schatten */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Eyebrow / Dachzeile */
  .wh-hero__eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem; /* 13px */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-700);
  }

  /* Hauptüberschrift (H1) */
  .wh-hero__title {
    font-size: 2.25rem; /* Große Schrift auf Mobile */
    line-height: 1.2;
    color: var(--color-dark);
    font-weight: 700;
    margin: 0;
  }

  /* Textabschnitt */
  .wh-hero__text {
    font-size: 1.0625rem; /* 17px für hervorragende Lesbarkeit */
    line-height: 1.75;
    color: var(--color-dark);
    opacity: 0.9;
    margin: 0;
    max-width: 55ch;
  }

  /* CTA Button */
  .wh-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%; /* Volle Breite auf Mobile */
    padding: 0.875rem 1.75rem;
    background-color: var(--color-primary-500);
    border: 2px solid var(--color-primary-500);
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius);
    text-decoration: none;
    box-shadow: 0 4px 12px rgb(255 183 48 / 0.25);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .wh-btn-primary:hover {
    background-color: transparent;
    border-color: var(--color-primary-500);
    color: var(--color-primary-800);
    box-shadow: none;
  }

  .wh-btn-icon {
    transition: transform 0.2s ease;
  }

  .wh-btn-primary:hover .wh-btn-icon {
    transform: translateX(4px);
  }

  .wh-btn-primary:focus-visible {
    outline: 2px solid var(--color-dark);
    outline-offset: 3px;
  }

  /* Hilfsklassen */
  .desktop-only {
    display: none;
  }

  /* =========================================
     TABLET & DESKTOP BREAKPOINTS
     ========================================= */
  @media (min-width: 768px) {
    .wh-hero {
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
    
    .wh-hero__title {
      font-size: 2.75rem;
    }

    .wh-hero__content {
      padding: 2.5rem;
      margin-top: -5rem;
    }

    .wh-btn-primary {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .desktop-only {
      display: block;
    }

    .wh-hero {
      padding-top: 4rem;
      padding-bottom: 5rem;
    }

    /* Zweispaltiges Grid auf Desktop, Text links, Bild rechts */
    .wh-hero__grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      align-items: center;
      gap: 4rem;
    }

    /* Deaktiviert Karten-Stile von Mobile in der Desktop-Ansicht */
    .wh-hero__content {
      background-color: transparent;
      border-radius: 0;
      padding: 0;
      margin-top: 0;
      box-shadow: none;
      grid-column: 1;
      gap: 1.25rem;
    }

    .wh-hero__image-wrapper {
      margin-inline: 0;
      width: 100%;
      grid-column: 2;
    }

    .wh-hero__img {
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-lg); /* Abgerundete Ecken auf Desktop */
      box-shadow: var(--shadow-warm-md);
    }
  }

  /* =========================================
     STATS SECTION (Dunkler Hintergrund & Typografische Overlays)
     ========================================= */
  .wh-stats {
    padding-top: 5rem;
    padding-bottom: 5.5rem;
    background-color: var(--color-dark); /* Edles Dunkelblau-Grau */
    overflow: hidden;
  }

  .wh-stats__layout {
    display: flex;
    flex-direction: column;
    gap: 4rem; /* Abstand zwischen den Blöcken auf Mobile */
  }

  /* Stat Block mit edler L-förmiger Umrandung */
  .wh-stats__block {
    position: relative;
    width: 100%;
    min-height: 140px;
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(235, 225, 208, 0.15); /* Dünne Linie oben */
    border-left: 1px solid rgba(235, 225, 208, 0.15); /* Dünne Linie links */
    border-top-left-radius: var(--radius); /* Reduzierter 6px Eckenradius */
    padding: 1.5rem 1rem 1rem 1.5rem;
    box-sizing: border-box;
  }

  /* Kleiner goldener Punkt am Treffpunkt der Rahmenlinien (Blueprint-Stil) */
  .wh-stats__block::before {
    content: '';
    position: absolute;
    left: -2.5px;
    top: -2.5px;
    width: 5px;
    height: 5px;
    background-color: var(--color-primary-500);
    border-radius: 50%;
    z-index: 3;
  }

  /* Mobile Staggering: Leicht versetzt zur optischen Auflockerung */
  .wh-stats__block--1 {
    align-self: flex-start;
    max-width: 290px;
  }

  .wh-stats__block--2 {
    align-self: flex-end;
    max-width: 290px;
  }

  .wh-stats__block--3 {
    align-self: flex-start;
    max-width: 290px;
    margin-left: 8%;
  }

  /* Riesige Outline-Zahl im Hintergrund */
  .wh-stats__giant-bg {
    position: absolute;
    left: 20%;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-heading);
    font-size: 8rem;
    font-weight: 900;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 183, 48, 0.12); /* Zarter goldener Umriss */
    user-select: none;
    z-index: 1;
    letter-spacing: -0.04em;
  }

  /* Vordergrund-Inhalt (Überlappt die Hintergrund-Zahl) */
  .wh-stats__fg {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    pointer-events: none;
  }

  /* Echte, solide Zahl im Vordergrund */
  .wh-stats__number {
    font-family: var(--font-heading);
    font-size: 2.5rem; /* 40px */
    font-weight: 800;
    color: var(--color-primary-500); /* Unsere Hauptfarbe */
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
  }

  /* Stat-Label */
  .wh-stats__label {
    font-family: var(--font-body);
    font-size: 0.875rem; /* 14px */
    font-weight: 700;
    color: var(--color-base); /* Warmer Creme-Ton */
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.3;
    opacity: 0.95;
  }

  /* =========================================
     TABLET & DESKTOP BREAKPOINTS
     ========================================= */
  @media (min-width: 768px) {
    .wh-stats__layout {
      flex-direction: row;
      justify-content: space-between;
      gap: 2rem;
    }

    .wh-stats__block {
      flex: 1;
      align-self: auto !important;
      margin-left: 0 !important;
      min-height: 170px;
      padding: 2rem 1.5rem 1.5rem 2rem;
    }

    .wh-stats__giant-bg {
      font-size: 8rem;
      left: 15%;
    }
  }

  @media (min-width: 1024px) {
    .wh-stats {
      padding-top: 7rem;
      padding-bottom: 8rem;
    }

    .wh-stats__layout {
      max-width: 1100px;
      margin-inline: auto;
      gap: 3.5rem;
    }

    .wh-stats__giant-bg {
      font-size: 9.5rem;
      left: 20%;
    }

    .wh-stats__number {
      font-size: 3rem; /* 48px */
    }

    .wh-stats__label {
      font-size: 0.9375rem; /* 15px */
    }
  }
</style>
