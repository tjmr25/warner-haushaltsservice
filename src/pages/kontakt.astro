---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt – So erreichen Sie uns"
  description="Kontaktieren Sie Warner Haushaltsservice Hamburg. Telefon: 040 / 29 81 25 40, E-Mail: info@warner-hamburg.de. Haubachstraße 80, 22765 Hamburg."
>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero" aria-labelledby="kontakt-hero-heading">
    <div class="container-content">
      <a href="/" class="breadcrumb">← Startseite</a>
      <p class="section-label">Wir sind für Sie da</p>
      <h1 id="kontakt-hero-heading">
        <span class="highlight-italic">Kontakt</span>
      </h1>
      <div class="accent-divider"></div>
      <p class="page-hero-sub">
        Haben Sie Fragen oder möchten Sie ein unverbindliches Beratungsgespräch
        vereinbaren? Wir freuen uns auf Ihre Nachricht!
      </p>
    </div>
  </section>

  <!-- ===== CONTACT MAIN ===== -->
  <section class="section-padding bg-warm-light" aria-labelledby="contact-main-heading">
    <div class="container-content">
      <h2 id="contact-main-heading" class="sr-only">Kontaktmöglichkeiten</h2>

      <div class="contact-layout">

        <!-- Contact Info Left -->
        <div class="contact-info">

          <!-- Phone CTA – most prominent -->
          <a href="tel:+4940298125400" class="contact-card contact-card--primary" aria-label="Jetzt anrufen: 040 29 81 25 40">
            <div class="contact-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
            </div>
            <div class="contact-card-text">
              <p class="contact-card-label">Telefon</p>
              <p class="contact-card-value">040 / 29 81 25 40</p>
              <p class="contact-card-hint">Jetzt anrufen →</p>
            </div>
          </a>

          <!-- Email -->
          <a href="mailto:info@warner-hamburg.de" class="contact-card" aria-label="E-Mail schreiben an info@warner-hamburg.de">
            <div class="contact-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="contact-card-text">
              <p class="contact-card-label">E-Mail</p>
              <p class="contact-card-value">info@warner-hamburg.de</p>
              <p class="contact-card-hint">E-Mail schreiben →</p>
            </div>
          </a>

          <!-- Address -->
          <div class="contact-card contact-card--static">
            <div class="contact-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <address class="contact-card-text">
              <p class="contact-card-label">Anschrift</p>
              <p class="contact-card-value">Warner Haushaltsservice GmbH</p>
              <p class="contact-card-value contact-card-value--light">
                Haubachstraße 80<br />22765 Hamburg
              </p>
            </address>
          </div>

          <!-- Opening Hours -->
          <div class="contact-card contact-card--static">
            <div class="contact-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="contact-card-text">
              <p class="contact-card-label">Erreichbarkeit</p>
              <p class="contact-card-value">Mo – Fr: 09:00 – 17:00 Uhr</p>
              <p class="contact-card-value contact-card-value--light">
                Wir melden uns so schnell wie möglich.
              </p>
            </div>
          </div>
        </div>

        <!-- Contact Form Right -->
        <div class="contact-form-wrap">
          <form
            id="contact-form"
            class="contact-form"
            method="POST"
            action="/kontakt-danke"
            novalidate
            aria-label="Kontaktformular"
          >
            <h2 class="form-heading">Nachricht senden</h2>
            <p class="form-sub">Wir antworten in der Regel innerhalb von 1–2 Werktagen.</p>

            <div class="form-group">
              <label for="name" class="form-label">Ihr Name <span aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                autocomplete="name"
                required
                placeholder="Vorname Nachname"
              />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">E-Mail-Adresse <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                autocomplete="email"
                required
                placeholder="ihre@email.de"
              />
            </div>

            <div class="form-group">
              <label for="phone" class="form-label">Telefonnummer (optional)</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="form-input"
                autocomplete="tel"
                placeholder="040 / ..."
              />
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Betreff <span aria-hidden="true">*</span></label>
              <select id="subject" name="subject" class="form-input form-select" required>
                <option value="" disabled selected>Bitte wählen ...</option>
                <option value="haushaltshilfe">Haushaltshilfe (Privat)</option>
                <option value="pflegekasse">Alltagsunterstützung / Pflegekasse</option>
                <option value="erstgespraech">Unverbindliches Erstgespräch</option>
                <option value="sonstiges">Sonstiges</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Ihre Nachricht <span aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                class="form-input form-textarea"
                required
                rows="5"
                placeholder="Wie können wir Ihnen helfen? ..."
              ></textarea>
            </div>

            <div class="form-privacy">
              <input type="checkbox" id="privacy" name="privacy" required class="form-checkbox" />
              <label for="privacy" class="form-privacy-label">
                Ich habe die <a href="/datenschutz" class="form-link">Datenschutzerklärung</a>
                gelesen und stimme der Verarbeitung meiner Daten zu.
                <span aria-hidden="true"> *</span>
              </label>
            </div>

            <button type="submit" id="form-submit" class="btn-primary form-submit">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Nachricht absenden
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== MAP PLACEHOLDER ===== -->
  <section class="map-section" aria-label="Standort Hamburg-Altona">
    <div class="map-overlay">
      <div class="map-card">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div>
          <p class="map-card-title">Warner Haushaltsservice GmbH</p>
          <p class="map-card-address">Haubachstraße 80 · 22765 Hamburg</p>
          <a
            href="https://maps.google.com/?q=Haubachstraße+80,+22765+Hamburg"
            target="_blank"
            rel="noopener noreferrer"
            class="map-link"
          >
            In Google Maps öffnen →
          </a>
        </div>
      </div>
    </div>
    <iframe
      title="Standort Warner Haushaltsservice, Haubachstraße 80, Hamburg"
      src="https://www.openstreetmap.org/export/embed.html?bbox=9.93,53.54,9.96,53.56&layer=mapnik&marker=53.5508,9.9437"
      width="100%"
      height="420"
      style="border: 0; display: block;"
      loading="lazy"
      aria-label="Karte mit dem Standort des Warner Haushaltsservice in Hamburg-Altona"
    ></iframe>
  </section>

</Layout>

<style>
  main { padding-top: 4.5rem; }
  @media (min-width: 1024px) { main { padding-top: 5rem; } }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;
  }

  .breadcrumb {
    display: inline-flex; align-items: center; gap: 0.375rem;
    font-size: 0.875rem; color: #7d6e5e; text-decoration: none;
    margin-bottom: 1rem; transition: color 0.2s ease;
  }
  .breadcrumb:hover { color: #2a2018; }

  /* PAGE HERO */
  .page-hero { background-color: #fbf9f4; padding-top: 3rem; padding-bottom: 3.5rem; }
  .page-hero h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800; margin: 0.5rem 0 0; line-height: 1.15; color: #2a2018;
  }
  .highlight-italic {
    color: #ffb730; font-style: italic;
    font-family: "Newsreader", Georgia, serif;
  }
  .page-hero-sub { font-size: 1.0625rem; line-height: 1.7; color: #3d322a; margin: 0; max-width: 560px; }

  /* CONTACT LAYOUT */
  .contact-layout {
    display: grid; grid-template-columns: 1fr;
    gap: 2.5rem; align-items: start;
  }
  @media (min-width: 1024px) { .contact-layout { grid-template-columns: 1fr 1.4fr; gap: 4rem; } }

  /* CONTACT INFO */
  .contact-info { display: flex; flex-direction: column; gap: 1rem; }

  .contact-card {
    display: flex; align-items: flex-start; gap: 1.25rem;
    background-color: #fbf9f4;
    border: 1px solid #e8e2d6; border-radius: 1rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: box-shadow 0.25s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .contact-card:not(.contact-card--static):hover {
    box-shadow: 0 8px 28px rgba(42, 32, 24, 0.1);
    transform: translateY(-2px);
    border-color: rgba(255, 183, 48, 0.4);
  }
  .contact-card--primary {
    background: linear-gradient(135deg, #fff9eb 0%, #fbf9f4 100%);
    border-color: rgba(255, 183, 48, 0.4);
  }
  .contact-card--static { cursor: default; }

  .contact-card-icon {
    width: 3rem; height: 3rem;
    background-color: #fff9eb; border-radius: 0.75rem;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .contact-card-label {
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: #a47038; margin: 0 0 0.25rem;
  }
  .contact-card-value {
    font-size: 1.125rem; font-weight: 700; color: #2a2018; margin: 0;
    font-style: normal;
  }
  .contact-card-value--light { font-size: 0.9375rem; font-weight: 400; color: #3d322a; margin-top: 0.125rem; }
  .contact-card-hint {
    font-size: 0.8125rem; color: #a47038; margin: 0.375rem 0 0;
    font-weight: 600;
  }

  /* CONTACT FORM */
  .contact-form-wrap {
    background-color: #fbf9f4;
    border: 1px solid #e8e2d6; border-radius: 1.5rem;
    padding: 2rem;
  }

  .form-heading { font-size: 1.375rem; margin: 0 0 0.375rem; color: #2a2018; }
  .form-sub { font-size: 0.9rem; color: #7d6e5e; margin: 0 0 1.75rem; }

  .form-group { display: flex; flex-direction: column; gap: 0.375rem; margin-bottom: 1.125rem; }

  .form-label {
    font-size: 0.9rem; font-weight: 600; color: #2a2018;
  }
  .form-label span { color: #c0392b; }

  .form-input {
    width: 100%; padding: 0.75rem 1rem;
    background-color: #f5f3ee;
    border: 1.5px solid #d4cbbf;
    border-radius: 0.5rem;
    font-size: 1rem; font-family: inherit;
    color: #2a2018;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    box-sizing: border-box;
    -webkit-appearance: none;
  }
  .form-input:focus {
    outline: none;
    border-color: #ffb730;
    background-color: #fbf9f4;
    box-shadow: 0 0 0 3px rgba(255, 183, 48, 0.2);
  }
  .form-input::placeholder { color: #b8ab9a; }

  .form-select { cursor: pointer; }

  .form-textarea { resize: vertical; min-height: 120px; }

  /* Privacy */
  .form-privacy {
    display: flex; align-items: flex-start; gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .form-checkbox {
    width: 1.125rem; height: 1.125rem;
    border: 2px solid #d4cbbf; border-radius: 0.25rem;
    cursor: pointer; flex-shrink: 0; margin-top: 0.15rem;
    accent-color: #ffb730;
  }
  .form-privacy-label { font-size: 0.875rem; color: #5b3824; line-height: 1.55; }
  .form-link { color: #a47038; text-decoration: underline; }
  .form-link:hover { color: #2a2018; }

  .form-submit { width: 100%; justify-content: center; }

  /* MAP */
  .map-section { position: relative; }
  .map-section iframe { filter: sepia(15%) contrast(95%); }

  .map-overlay {
    position: absolute; top: 1.5rem; left: 50%;
    transform: translateX(-50%);
    z-index: 10; width: calc(100% - 2rem); max-width: 400px;
  }
  .map-card {
    background: rgba(251, 249, 244, 0.96);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid #e8e2d6; border-radius: 1rem;
    padding: 1.125rem 1.25rem;
    display: flex; align-items: flex-start; gap: 0.875rem;
    box-shadow: 0 4px 24px rgba(42, 32, 24, 0.12);
  }
  .map-card svg { flex-shrink: 0; margin-top: 0.1rem; }
  .map-card-title { font-size: 0.9375rem; font-weight: 700; color: #2a2018; margin: 0 0 0.125rem; }
  .map-card-address { font-size: 0.875rem; color: #3d322a; margin: 0 0 0.5rem; }
  .map-link {
    font-size: 0.8125rem; font-weight: 600; color: #a47038;
    text-decoration: none; transition: color 0.2s ease;
  }
  .map-link:hover { color: #2a2018; }
</style>
