---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt – Warner Haushaltsservice Hamburg"
  description="Nehmen Sie Kontakt mit Warner Haushaltsservice in Hamburg auf. Wir freuen uns auf Ihre Nachricht."
>
  <!-- KONTAKT-SEITE -->
  <div class="relative min-h-screen bg-(--color-base) overflow-hidden">

    <!-- Dezent schwebende Hintergrund-Elemente (Monogramm / feine Formen in neutralen Creme-Tönen) -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
      <!-- Monogramm / Dezent schwebende Formen (Creme / Soft Grey) -->
      <div class="absolute -top-16 -right-16 w-96 h-96 rounded-full border border-(--color-secondary)/40 opacity-30 animate-[pulse_10s_infinite_ease-in-out]"></div>
      <div class="absolute top-1/3 -left-20 w-80 h-80 rounded-full border border-(--color-secondary)/50 opacity-20"></div>
      <div class="absolute bottom-20 right-10 w-72 h-72 rounded-full border border-(--color-secondary)/30 opacity-25"></div>

      <!-- Ganz feines Punkte-Raster -->
      <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(27,34,39,0.035)_1px,transparent_1px)] [background-size:28px_28px]"></div>
    </div>

    <!-- Hauptsektion -->
    <section class="wh-section container-page relative z-10" aria-labelledby="kontakt-heading">

      <!-- Section Header: Einfarbige Überschrift -->
      <div class="mb-10 max-w-[58ch]">
        <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold uppercase tracking-[0.08em] text-(--color-primary-700) mb-2 block">
          Wir sind für Sie da
        </span>
        <h1 id="kontakt-heading" class="m-0 font-[family-name:var(--font-heading)] text-[2rem] sm:text-[2.5rem] lg:text-[3rem] font-extrabold leading-[1.15] text-(--color-dark) mb-4">
          Kontakt aufnehmen
        </h1>
        <p class="m-0 text-[1.0625rem] leading-[1.75] text-(--color-dark) opacity-75">
          Haben Sie Fragen zu unseren Leistungen oder möchten Sie eine Haushaltshilfe anfragen?
          Schreiben Sie uns gerne über das Formular oder rufen Sie uns direkt an.
        </p>
      </div>

      <!-- 2-Spalten-Layout: Formular + Info (ohne Karten) -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] xl:grid-cols-[1fr_380px] gap-10 lg:gap-14 items-start">

        <!-- FORMULAR CONTAINER -->
        <div class="bg-white rounded-[var(--radius-xl)] border border-(--color-secondary) p-6 sm:p-9 shadow-[0_4px_20px_rgb(27_34_39/0.04)]">

          <!-- ARIA Live Statusbereich -->
          <div id="form-status" class="hidden rounded-[var(--radius-lg)] p-4 text-[0.9375rem] leading-relaxed mb-6" role="status" aria-live="polite" aria-atomic="true"></div>

          <form
            id="kontaktForm"
            class="flex flex-col gap-5"
            action="https://formspree.io/f/xrbzqbkn"
            method="POST"
            novalidate
            aria-label="Kontaktformular"
          >
            <!-- Honeypot (Spam-Schutz für Bots) -->
            <div class="sr-only" aria-hidden="true">
              <label for="website">Website (bitte leer lassen)</label>
              <input type="text" id="website" name="_honey" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" name="_subject" value="Neue Kontaktanfrage – Warner Haushaltsservice" />

            <!-- Vorname + Nachname -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="flex flex-col gap-1.5">
                <label for="vorname" class="font-[family-name:var(--font-body)] text-[0.875rem] font-semibold text-(--color-dark)">
                  Vorname <span class="text-[#c0392b]" aria-label="Pflichtfeld">*</span>
                </label>
                <input
                  type="text" id="vorname" name="vorname"
                  class="w-full px-4 py-3 font-[family-name:var(--font-body)] text-[1rem] text-(--color-dark) bg-(--color-base) border border-(--color-secondary) rounded-[var(--radius-lg)] outline-none transition-all duration-200 focus:border-(--color-primary-500) focus:bg-white focus:ring-2 focus:ring-(--color-primary-500)/25"
                  autocomplete="given-name" required minlength="2" maxlength="80"
                  aria-required="true" aria-errormessage="vorname-error"
                />
                <span id="vorname-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte geben Sie Ihren Vornamen ein (mind. 2 Zeichen).</span>
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="nachname" class="font-[family-name:var(--font-body)] text-[0.875rem] font-semibold text-(--color-dark)">
                  Nachname <span class="text-[#c0392b]" aria-label="Pflichtfeld">*</span>
                </label>
                <input
                  type="text" id="nachname" name="nachname"
                  class="w-full px-4 py-3 font-[family-name:var(--font-body)] text-[1rem] text-(--color-dark) bg-(--color-base) border border-(--color-secondary) rounded-[var(--radius-lg)] outline-none transition-all duration-200 focus:border-(--color-primary-500) focus:bg-white focus:ring-2 focus:ring-(--color-primary-500)/25"
                  autocomplete="family-name" required minlength="2" maxlength="80"
                  aria-required="true" aria-errormessage="nachname-error"
                />
                <span id="nachname-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte geben Sie Ihren Nachnamen ein (mind. 2 Zeichen).</span>
              </div>
            </div>

            <!-- E-Mail -->
            <div class="flex flex-col gap-1.5">
              <label for="email" class="font-[family-name:var(--font-body)] text-[0.875rem] font-semibold text-(--color-dark)">
                E-Mail-Adresse <span class="text-[#c0392b]" aria-label="Pflichtfeld">*</span>
              </label>
              <input
                type="email" id="email" name="email"
                class="w-full px-4 py-3 font-[family-name:var(--font-body)] text-[1rem] text-(--color-dark) bg-(--color-base) border border-(--color-secondary) rounded-[var(--radius-lg)] outline-none transition-all duration-200 focus:border-(--color-primary-500) focus:bg-white focus:ring-2 focus:ring-(--color-primary-500)/25"
                autocomplete="email" required maxlength="254"
                aria-required="true" aria-errormessage="email-error"
                inputmode="email"
              />
              <span id="email-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte geben Sie eine gültige E-Mail-Adresse ein.</span>
            </div>

            <!-- Telefon (optional) -->
            <div class="flex flex-col gap-1.5">
              <label for="telefon" class="font-[family-name:var(--font-body)] text-[0.875rem] font-semibold text-(--color-dark)">
                Telefonnummer <span class="text-[0.8125rem] font-normal opacity-50 ml-1">(optional)</span>
              </label>
              <input
                type="tel" id="telefon" name="telefon"
                class="w-full px-4 py-3 font-[family-name:var(--font-body)] text-[1rem] text-(--color-dark) bg-(--color-base) border border-(--color-secondary) rounded-[var(--radius-lg)] outline-none transition-all duration-200 focus:border-(--color-primary-500) focus:bg-white focus:ring-2 focus:ring-(--color-primary-500)/25"
                autocomplete="tel" maxlength="25" pattern="[\d\s\+\-\(\)]{6,25}"
                aria-errormessage="telefon-error"
                inputmode="tel"
              />
              <span id="telefon-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte geben Sie eine gültige Telefonnummer ein.</span>
            </div>

            <!-- Betreff / Anliegen (reduziert auf 3 Optionen) -->
            <div class="flex flex-col gap-1.5">
              <label for="betreff" class="font-[family-name:var(--font-body)] text-[0.875rem] font-semibold text-(--color-dark)">
                Ihr Anliegen <span class="text-[#c0392b]" aria-label="Pflichtfeld">*</span>
              </label>
              <select
                id="betreff" name="betreff"
                class="w-full px-4 py-3 font-[family-name:var(--font-body)] text-[1rem] text-(--color-dark) bg-(--color-base) border border-(--color-secondary) rounded-[var(--radius-lg)] outline-none transition-all duration-200 focus:border-(--color-primary-500) focus:bg-white focus:ring-2 focus:ring-(--color-primary-500)/25 cursor-pointer appearance-none bg-[url('data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2216%22%20height%3D%2216%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%231b2227%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpolyline%20points%3D%226%209%2012%2015%2018%209%22%2F%3E%3C%2Fsvg%3E')] bg-[length:16px_16px] bg-[position:right_1rem_center] bg-no-repeat pr-10"
                required aria-required="true" aria-errormessage="betreff-error"
              >
                <option value="" disabled selected>Bitte wählen …</option>
                <option value="Privathaushalte">Privathaushalte</option>
                <option value="Pflegebedürftige">Pflegebedürftige</option>
                <option value="Sonstiges">Sonstiges</option>
              </select>
              <span id="betreff-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte wählen Sie ein Anliegen aus.</span>
            </div>

            <!-- Nachricht -->
            <div class="flex flex-col gap-1.5">
              <label for="nachricht" class="font-[family-name:var(--font-body)] text-[0.875rem] font-semibold text-(--color-dark)">
                Ihre Nachricht <span class="text-[#c0392b]" aria-label="Pflichtfeld">*</span>
              </label>
              <textarea
                id="nachricht" name="nachricht"
                class="w-full px-4 py-3 font-[family-name:var(--font-body)] text-[1rem] text-(--color-dark) bg-(--color-base) border border-(--color-secondary) rounded-[var(--radius-lg)] outline-none transition-all duration-200 focus:border-(--color-primary-500) focus:bg-white focus:ring-2 focus:ring-(--color-primary-500)/25 min-h-[120px] max-h-[300px] resize-y"
                required minlength="10" maxlength="2000" rows="5"
                aria-required="true" aria-errormessage="nachricht-error"
              ></textarea>
              <div class="flex justify-between items-center text-[0.8125rem] text-(--color-dark) opacity-60">
                <span>Mind. 10 Zeichen</span>
                <span id="nachricht-counter" aria-live="polite">0 / 2000</span>
              </div>
              <span id="nachricht-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte geben Sie eine Nachricht ein (mind. 10 Zeichen).</span>
            </div>

            <!-- Datenschutz -->
            <div class="flex flex-col gap-1.5 pt-1">
              <div class="flex items-start gap-3">
                <input
                  type="checkbox" id="datenschutz" name="datenschutz"
                  class="mt-1 w-4 h-4 rounded accent-(--color-primary-500) cursor-pointer"
                  required aria-required="true" aria-errormessage="datenschutz-error"
                />
                <label for="datenschutz" class="text-[0.875rem] text-(--color-dark) leading-relaxed cursor-pointer">
                  Ich habe die <a href="/datenschutz" class="text-(--color-primary-700) font-semibold underline hover:text-(--color-primary-600)" target="_blank" rel="noopener">Datenschutzerklärung</a>
                  gelesen und stimme der Verarbeitung meiner Daten zur Bearbeitung meiner Anfrage zu.
                  <span class="text-[#c0392b]" aria-label="Pflichtfeld">*</span>
                </label>
              </div>
              <span id="datenschutz-error" class="hidden text-[0.8125rem] text-red-600 font-medium">Bitte bestätigen Sie die Datenschutzerklärung.</span>
            </div>

            <!-- Absenden Button -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
              <button
                type="submit" id="submit-btn"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark) bg-(--color-primary-500) border-2 border-(--color-primary-500) rounded-[var(--radius-lg)] cursor-pointer shadow-[0_2px_8px_rgb(255_183_48/0.3)] transition-all duration-200 hover:bg-(--color-primary-400) hover:border-(--color-primary-400) hover:-translate-y-0.5 hover:shadow-[0_4px_16px_rgb(255_183_48/0.4)] active:translate-y-0 disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span>Nachricht senden</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
              </button>
              <span class="text-[0.8125rem] text-(--color-dark) opacity-50">* Pflichtfelder</span>
            </div>

          </form>
        </div>

        <!-- KONTAKT-INFO SPALTE (Schlicht mit Trennlinien, OHNE KARTEN) -->
        <aside class="flex flex-col" aria-label="Kontaktinformationen">

          <!-- Adresse -->
          <div class="flex items-start gap-4 py-5 border-b border-(--color-secondary)">
            <div class="flex items-center justify-center w-10 h-10 rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700) shrink-0 mt-0.5" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-wider text-(--color-dark) opacity-50 m-0 mb-1">Adresse</p>
              <address class="not-italic text-[0.9375rem] leading-relaxed text-(--color-dark)">
                Warner Haushaltsservice GmbH<br />
                Haubachstraße 80<br />
                22765 Hamburg
              </address>
            </div>
          </div>

          <!-- Telefon -->
          <div class="flex items-start gap-4 py-5 border-b border-(--color-secondary)">
            <div class="flex items-center justify-center w-10 h-10 rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700) shrink-0 mt-0.5" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.29h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.16 6.16l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-wider text-(--color-dark) opacity-50 m-0 mb-1">Telefon</p>
              <a href="tel:+494029812540" class="text-[0.9375rem] font-semibold text-(--color-primary-700) hover:underline">040 / 29 81 25 40</a>
            </div>
          </div>

          <!-- E-Mail -->
          <div class="flex items-start gap-4 py-5 border-b border-(--color-secondary)">
            <div class="flex items-center justify-center w-10 h-10 rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700) shrink-0 mt-0.5" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <p class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-wider text-(--color-dark) opacity-50 m-0 mb-1">E-Mail</p>
              <a href="mailto:info@warner-hamburg.de" class="text-[0.9375rem] font-semibold text-(--color-primary-700) hover:underline break-all">info@warner-hamburg.de</a>
            </div>
          </div>

          <!-- Bürozeiten -->
          <div class="flex items-start gap-4 py-5">
            <div class="flex items-center justify-center w-10 h-10 rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700) shrink-0 mt-0.5" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <p class="font-[family-name:var(--font-heading)] text-[0.8125rem] font-bold uppercase tracking-wider text-(--color-dark) opacity-50 m-0 mb-1">Bürozeiten</p>
              <dl class="m-0 text-[0.9375rem] leading-relaxed text-(--color-dark)">
                <div class="flex gap-2"><dt class="font-semibold w-16 opacity-70">Mo – Do</dt><dd class="m-0 opacity-90">07:30 – 16:00 Uhr</dd></div>
                <div class="flex gap-2"><dt class="font-semibold w-16 opacity-70">Fr</dt><dd class="m-0 opacity-90">07:30 – 14:00 Uhr</dd></div>
              </dl>
            </div>
          </div>

        </aside>

      </div>
    </section>
  </div>
</Layout>

<script>
  function initFormLogic() {
    const form = document.getElementById('kontaktForm') as HTMLFormElement | null;
    if (!form) return;

    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const statusEl  = document.getElementById('form-status') as HTMLElement | null;
    const nachrEl   = document.getElementById('nachricht') as HTMLTextAreaElement | null;
    const counterEl = document.getElementById('nachricht-counter') as HTMLElement | null;

    if (nachrEl && counterEl) {
      nachrEl.addEventListener('input', () => {
        const len = nachrEl.value.length;
        counterEl.textContent = `${len} / 2000`;
        counterEl.style.color = len > 1900 ? '#dc2626' : '';
      });
    }

    const RATE_LIMIT_MS = 30_000;
    let lastSubmit = 0;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const now = Date.now();
      if (now - lastSubmit < RATE_LIMIT_MS) {
        const rem = Math.ceil((RATE_LIMIT_MS - (now - lastSubmit)) / 1000);
        showMsg('error', `Bitte warten Sie noch ${rem} Sekunden, bevor Sie erneut senden.`);
        return;
      }

      const honey = form.querySelector('input[name="_honey"]') as HTMLInputElement | null;
      if (honey && honey.value.trim() !== '') {
        showMsg('success', '✓ Ihre Nachricht wurde erfolgreich gesendet!');
        form.reset();
        return;
      }

      // Validierung
      let valid = true;
      const fields = ['vorname', 'nachname', 'email', 'betreff', 'nachricht', 'datenschutz'];
      fields.forEach((id) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        const err = document.getElementById(`${id}-error`);
        if (!el || !err) return;

        let isFieldValid = el.checkValidity();
        if (id === 'datenschutz') {
          isFieldValid = (el as HTMLInputElement).checked;
        }

        if (!isFieldValid) {
          valid = false;
          err.classList.remove('hidden');
          el.classList.add('border-red-500', 'bg-red-50');
        } else {
          err.classList.add('hidden');
          el.classList.remove('border-red-500', 'bg-red-50');
        }
      });

      if (!valid) {
        showMsg('error', 'Bitte füllen Sie alle erforderlichen Pflichtfelder korrekt aus.');
        return;
      }

      if (!submitBtn) return;
      submitBtn.disabled = true;
      showMsg('info', 'Wird gesendet …');

      try {
        const resp = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { 'Accept': 'application/json' },
        });

        if (resp.ok) {
          lastSubmit = Date.now();
          showMsg('success', '✓ Vielen Dank! Ihre Nachricht wurde erfolgreich gesendet. Wir antworten innerhalb von 1–2 Werktagen.');
          form.reset();
          if (counterEl) counterEl.textContent = '0 / 2000';
        } else {
          showMsg('error', 'Fehler beim Senden. Bitte versuchen Sie es später erneut oder rufen Sie uns an.');
        }
      } catch {
        showMsg('error', 'Verbindungsfehler. Bitte prüfen Sie Ihre Verbindung.');
      } finally {
        submitBtn.disabled = false;
      }
    });

    function showMsg(type: 'success' | 'error' | 'info', msg: string) {
      if (!statusEl) return;
      statusEl.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'border-green-300', 'bg-red-50', 'text-red-800', 'border-red-300', 'bg-blue-50', 'text-blue-800', 'border-blue-300', 'border');

      if (type === 'success') {
        statusEl.classList.add('bg-green-50', 'text-green-800', 'border-green-300', 'border');
      } else if (type === 'error') {
        statusEl.classList.add('bg-red-50', 'text-red-800', 'border-red-300', 'border');
      } else {
        statusEl.classList.add('bg-blue-50', 'text-blue-800', 'border-blue-300', 'border');
      }

      statusEl.textContent = msg;
    }
  }

  document.addEventListener('astro:page-load', initFormLogic);
</script>
