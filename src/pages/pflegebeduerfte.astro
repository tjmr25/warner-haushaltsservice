---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import pflegebeduerfteBild from '../assets/images/pflegebeduerfte_hero.jpg';

const detailedServices = [
  {
    num: "01",
    title: "Reinigung und Haushaltshilfe",
    desc: "Eine saubere und ordentliche Wohnumgebung trägt wesentlich zum Wohlbefinden bei. Wir unterstützen Sie zuverlässig bei der regelmäßigen Reinigung Ihres Zuhauses, einschließlich:",
    items: [
      "Reinigung von Wohn-, Schlaf-, Küchen- und Sanitärräumen",
      "Staubsaugen, Wischen und Oberflächenreinigung",
      "Unterstützung beim Aufräumen und Ordnung halten",
    ],
  },
  {
    num: "02",
    title: "Unterstützung beim Aufräumen",
    desc: "Gerade im Alltag kann Ordnung schwerfallen. Wir helfen dabei, den Wohnraum übersichtlich und sicher zu gestalten:",
    items: [
      "Gemeinsames Aufräumen von Wohnbereichen",
      "Unterstützung beim Sortieren und Ordnen",
      "Schaffung eines angenehmen und sicheren Wohnumfelds",
    ],
  },
  {
    num: "03",
    title: "Wäschepflege",
    desc: "Auch die Wäschepflege ist für viele Pflegebedürftige eine große Herausforderung. Unsere Unterstützung umfasst:",
    items: [
      "Waschen der Wäsche",
      "Trocknen und Zusammenlegen",
      "Ordnungsgemäßes Verstauen der Kleidung",
    ],
    note: "So sorgen wir für Hygiene, Ordnung und Entlastung im Alltag.",
  },
  {
    num: "04",
    title: "Fensterputzen und Gardinenpflege",
    desc: "Saubere Fenster und frische Gardinen sorgen für mehr Licht und Wohnkomfort, sind jedoch körperlich anstrengend. Wir übernehmen für Sie:",
    items: [
      "Fensterputzen in der Wohnung",
      "Abnehmen und Waschen von Gardinen",
      "Wiederanbringen der Gardinen",
    ],
  },
  {
    num: "05",
    title: "Gesellschaft und Alltagsbegleitung",
    desc: "Neben praktischer Hilfe ist soziale Unterstützung besonders wichtig. Wir nehmen uns Zeit für:",
    items: [
      "Gesellschaft und Gespräche",
      "Gemeinsame Aktivitäten im Alltag",
      "Persönliche Zuwendung und Begleitung",
    ],
    note: "Diese Form der Alltagsbegleitung stärkt das Wohlbefinden, beugt Einsamkeit vor und gibt Sicherheit.",
  },
];
---

<Layout
  title="Pflegebedürftige – Warner Haushaltsservice"
  description="Unterstützung und Entlastung für Pflegebedürftige und ihre Angehörigen in Hamburg."
>
  <PageHero
    eyebrow="Selbstbestimmt zu Hause leben"
    headingHtml="Haushaltshilfe für <span>Pflegebedürftige</span>"
    text="Wenn alltägliche Dinge zur Herausforderung werden, sind wir für Sie da. Wir unterstützen pflegebedürftige Menschen dabei, ihren Alltag so selbstbestimmt und angenehm wie möglich zu gestalten."
    badgeText="Abrechenbar über die Pflegekasse"
    imageSrc={pflegebeduerfteBild}
    imageAlt="Freundliche Alltagsbegleiterin unterstützt eine ältere Dame liebevoll in ihrem Zuhause"
    headingTag="h1"
    imageObjectPositionDesktop="center 35%"
  />

  <!-- =============================================
       UNTERSTÜTZUNG IM ALLTAG SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base-alt)"
    aria-labelledby="alltag-heading"
  >
    <div class="container-page">
      <div class="mx-auto flex max-w-3xl flex-col gap-6">
        <!-- Header block -->
        <div class="flex flex-col gap-3">
          <span
            class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
          >
            Individuelle Alltagshilfe
          </span>
          <h2
            id="alltag-heading"
            class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.5rem]"
          >
            Unterstützung, wenn der Alltag schwerfällt
          </h2>
          <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
        </div>

        <!-- Intro paragraphs -->
        <div class="flex flex-col gap-4">
          <p
            class="m-0 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85"
          >
            Wir nehmen uns Zeit, hören zu und passen unsere Hilfe individuell an
            die Bedürfnisse jedes Einzelnen an.
            Unser Ziel ist es, Entlastung zu schaffen, Sicherheit zu geben und
          die Lebensqualität zu erhalten – zuverlässig, respektvoll und
          menschlich.
          </p>
        </div>



        <!-- Consultation paragraph below card -->
        <p
          class="m-0 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85"
        >
          Gerne beraten wir Sie persönlich zu den Möglichkeiten der
          Kostenübernahme durch die Pflegekasse und zu unseren Leistungen.
        </p>

        <!-- Qualifications card -->
        <div
          class="w-full rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] md:w-[60%]"
        >
          <h3
            class="m-0 mb-5 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)"
          >
            Qualifikation unserer Mitarbeiterinnen
          </h3>
          <div class="flex flex-col gap-5">
            <!-- Badge 1 -->
            <div class="flex items-start gap-4">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700)"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <p
                class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80"
              >
                Mehrtägige, nach der <strong
                  class="font-semibold text-(--color-dark) opacity-100"
                  >Hamburgischen Pflege-Engagement-Verordnung</strong
                > anerkannte Schulung
              </p>
            </div>
            <!-- Badge 2 -->
            <div class="flex items-start gap-4">
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700)"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
              </div>
              <p
                class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80"
              >
                Alle Mitarbeiterinnen absolvieren einen <strong
                  class="font-semibold text-(--color-dark) opacity-100"
                  >Erste-Hilfe-Kurs</strong
                >
              </p>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="pt-2">
          <a
            href="/kontakt"
            class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-7 py-[0.875rem] font-[family-name:var(--font-heading)] text-[1rem] font-bold text-dark text-[#1b2227] no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:border-(--color-primary-400) hover:bg-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
          >
            Kompetent beraten lassen
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-1"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       UNSERE LEISTUNGEN IM DETAIL SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base)"
    aria-labelledby="detail-leistungen-heading"
  >
    <div class="container-page">
      <!-- Section Header -->
      <div class="mb-10 flex flex-col gap-3 lg:mb-12">
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Umfassende Pflege-Unterstützung
        </span>
        <h2
          id="detail-leistungen-heading"
          class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.75rem]"
        >
          Unsere Leistungen im Detail
        </h2>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
        <!-- Dezenter Hinweis zur Pflegekasse direkt unter dem Header -->
        <p class="mt-2 m-0 max-w-[65ch] text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
          Diese Leistungen zählen zu den haushaltsnahen Dienstleistungen und können unkompliziert im Rahmen der Entlastungsleistungen der Pflegekasse (§ 45b SGB XI) genutzt werden.
        </p>
      </div>

      <!-- Services Cards Grid -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          detailedServices.map((service) => (
            <div class="group relative flex flex-col justify-between rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]">
              <div>
                <!-- Number Badge -->
                <div class="mb-3 font-[family-name:var(--font-heading)] text-[2rem] font-extrabold leading-none text-(--color-primary-500)/40">
                  {service.num}
                </div>

                <!-- Title -->
                <h3 class="mb-3 m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)">
                  {service.title}
                </h3>

                <!-- Intro Description -->
                <p class="mb-5 m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                  {service.desc}
                </p>

                <!-- Checkmark Items -->
                <ul class="mb-4 flex flex-col gap-3 list-none m-0 p-0">
                  {service.items.map((item) => (
                    <li class="flex items-start gap-3 text-[0.9375rem] font-medium leading-[1.6] text-(--color-dark)">
                      <svg
                        class="mt-0.5 h-5 w-5 shrink-0 text-(--color-primary-600)"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Optional Note -->
              {service.note && (
                <p class="mt-4 m-0 border-t border-(--color-secondary)/60 pt-4 text-[0.875rem] italic leading-[1.6] text-(--color-dark) opacity-75">
                  {service.note}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =============================================
       ABRECHNUNG ÜBER DIE PFLEGEKASSE SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base-alt) overflow-hidden"
    aria-labelledby="abrechnung-heading"
  >
    <div class="container-page">

      <!-- Trust Banner – amber accent block -->
      <div
        class="relative mb-14 overflow-hidden rounded-[var(--radius-xl)] bg-gradient-to-br from-(--color-primary-400) via-(--color-primary-500) to-amber-400 p-8 md:p-12 shadow-[0_16px_48px_rgb(255_183_48/0.35)]"
      >
        <!-- Background decorative shield -->
        <svg
          aria-hidden="true"
          class="absolute right-6 top-1/2 -translate-y-1/2 opacity-[0.08]"
          width="220"
          height="220"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="none"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>

        <div class="relative z-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:gap-16">
          <!-- Credential Pill -->
          <div class="flex shrink-0 flex-col items-start gap-2 lg:items-center lg:text-center">
            <div
              class="flex h-16 w-16 items-center justify-center rounded-full bg-white/30 backdrop-blur-sm"
            >
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <span
              class="mt-1 font-[family-name:var(--font-body)] text-[0.75rem] font-bold uppercase tracking-[0.1em] text-white/80"
            >
              Offiziell anerkannt
            </span>
          </div>

          <!-- Statement -->
          <div class="flex flex-col gap-2">
            <h2
              id="abrechnung-heading"
              class="m-0 font-[family-name:var(--font-heading)] text-[1.625rem] font-bold leading-[1.2] text-(--color-dark) lg:text-[2rem]"
            >
              Abrechnung über die Pflegekasse – einfach und direkt
            </h2>
            <p class="m-0 max-w-[60ch] text-[1rem] leading-[1.7] text-(--color-dark)/85">
              Wir sind von der Stadt Hamburg anerkannt und berechtigt, unsere Leistungen direkt mit den Pflegekassen abzurechnen. Für Pflegebedürftige mit Pflegegrad bedeutet das: unkomplizierter Zugang zu professioneller Unterstützung, finanziert durch die Pflegekasse.
            </p>
          </div>
        </div>
      </div>

      <!-- Narrative Text – full width -->
      <div class="flex flex-col gap-8 max-w-[72ch]">
        <div class="flex flex-col gap-4 border-l-2 border-(--color-primary-400) pl-6">
          <h3
            class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)"
          >
            Warum die Anerkennung zählt
          </h3>
          <p class="m-0 text-[1rem] leading-[1.8] text-(--color-dark) opacity-85">
            Das Anerkennungsverfahren der Stadt Hamburg ist umfassend und anspruchsvoll – es stellt sicher, dass nur Anbieter zugelassen werden, die die gesetzlichen Anforderungen dauerhaft erfüllen. Für Pflegebedürftige und ihre Familien bedeutet das: Transparenz, geprüfte Qualität und Vertrauen.
          </p>
          <p class="m-0 text-[1rem] leading-[1.8] text-(--color-dark) opacity-85">
            Unsere Leistungen können unkompliziert im Rahmen der Entlastungsleistungen nach <strong class="font-semibold opacity-100">§ 45b SGB XI</strong> über die Pflegekasse abgerechnet werden. Wir unterstützen Pflegebedürftige im Alltag und entlasten gleichzeitig Angehörige spürbar.
          </p>
        </div>

        <div class="flex flex-col gap-4 border-l-2 border-(--color-primary-400) pl-6">
          <h3
            class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)"
          >
            Geschult, zertifiziert, verlässlich
          </h3>
          <p class="m-0 text-[1rem] leading-[1.8] text-(--color-dark) opacity-85">
            Alle Mitarbeiterinnen erhalten eine mehrtägige, nach der Hamburgischen Pflege-Engagement-Verordnung anerkannte Schulung sowie einen Erste-Hilfe-Kurs. Klare interne Abläufe und regelmäßige Qualitätsstandards sorgen dafür, dass jede Leistung zuverlässig, professionell und menschlich erbracht wird.
          </p>
        </div>

        <!-- CTA -->
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center">
          <a
            href="/kontakt"
            class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-7 py-[0.875rem] font-[family-name:var(--font-heading)] text-[1rem] font-bold text-dark text-[#1b2227] no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:border-(--color-primary-400) hover:bg-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
          >
            Persönlich beraten lassen
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-1"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <span class="text-[0.875rem] text-(--color-dark) opacity-65">
            Kostenlose Erstberatung zur Pflegekassenabrechnung
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       PFLEGEGRAD SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base)"
    aria-labelledby="pflegegrad-heading"
  >
    <div class="container-page">

      <!-- Section Header -->
      <div class="mb-10 flex flex-col gap-2">
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Pflegegrad &amp; Kostenübernahme
        </span>
        <h2
          id="pflegegrad-heading"
          class="m-0 font-[family-name:var(--font-heading)] text-[1.75rem] font-bold leading-[1.2] text-(--color-dark) lg:text-[2.25rem]"
        >
          Welche Leistungen können mit welchem Pflegegrad genutzt werden?
        </h2>
        <p class="m-0 mt-2 max-w-[65ch] text-[1rem] leading-[1.8] text-(--color-dark) opacity-80">
          Pflegebedürftige Menschen mit einem anerkannten Pflegegrad haben Anspruch auf Leistungen der Pflegekasse. Wir sind von der Stadt Hamburg anerkannt und erfüllen alle Voraussetzungen für die direkte Abrechnung.
        </p>
      </div>

      <!-- Pflegegrad Cards -->
      <div class="mb-10 flex flex-col gap-5 md:grid md:grid-cols-2">

        <!-- Pflegegrad 1 -->
        <div class="rounded-[var(--radius-xl)] border border-(--color-secondary)/70 bg-white p-6 md:p-8">
          <h3 class="m-0 mb-3 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-primary-700)">
            Pflegegrad 1
          </h3>
          <p class="mb-4 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-85">
            Bereits mit Pflegegrad 1 besteht Anspruch auf den monatlichen Entlastungsbetrag von <strong class="font-semibold text-(--color-dark) opacity-100">131 Euro</strong>. Dieser kann für anerkannte Alltagsunterstützungsleistungen genutzt werden:
          </p>
          <ul class="m-0 flex flex-col gap-2.5 pl-0 list-none">
            {[
              "Reinigung der Wohnung",
              "Unterstützung beim Aufräumen",
              "Wäschepflege",
              "Fensterputzen",
              "Waschen und Abnehmen von Gardinen",
              "Gesellschaft und Alltagsbegleitung",
            ].map((item) => (
              <li class="flex items-start gap-3 text-[0.9375rem] leading-[1.6] text-(--color-dark) opacity-85">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-[3px] shrink-0 text-(--color-primary-600)"
                >
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Pflegegrad 2 bis 5 -->
        <div class="rounded-[var(--radius-xl)] border border-(--color-secondary)/70 bg-white p-6 md:p-8">
          <h3 class="m-0 mb-3 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-primary-700)">
            Pflegegrad 2 bis 5
          </h3>
          <div class="flex flex-col gap-3">
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-85">
              Auch mit Pflegegrad 2–5 steht der monatliche Entlastungsbetrag von <strong class="font-semibold text-(--color-dark) opacity-100">131 Euro</strong> zur Verfügung.
            </p>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-85">
              Zusätzlich können – abhängig von der persönlichen Situation – weitere Leistungen wie z. B. die <strong class="font-semibold text-(--color-dark) opacity-100">Verhinderungspflege</strong> genutzt werden.
            </p>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-85">
              Die Abrechnung erfolgt unkompliziert direkt mit der Pflegekasse.
            </p>
          </div>
        </div>
      </div>

      <!-- Gut zu wissen – horizontal strip -->
      <div class="w-full rounded-[var(--radius-xl)] bg-(--color-base-alt) p-6 md:p-8 md:w-[75%] mx-auto">
        <p class="mb-4 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark)">
          Gut zu wissen
        </p>
        <ul class="m-0 flex flex-col gap-3 pl-0 list-none">
          {[
            "Nicht genutzte Entlastungsbeträge können in der Regel angespart und zu einem späteren Zeitpunkt verwendet werden.",
            "Der Entlastungsbetrag ist für alle Pflegegrade gleich hoch – der individuelle Unterstützungsbedarf kann jedoch variieren.",
            "Als anerkannter Anbieter in Hamburg erfüllen wir alle Voraussetzungen für die Abrechnung mit der Pflegekasse.",
          ].map((tip) => (
            <li class="flex items-start gap-3 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-85">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="mt-[3px] shrink-0 text-(--color-primary-600)"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              {tip}
            </li>
          ))}
        </ul>
      </div>

    </div>
  </section>

  <!-- =============================================
       UNKOMPLIZIERTE ABRECHNUNG – dark high-contrast section
       ============================================= -->
  <section class="wh-section bg-(--color-dark)" aria-labelledby="abwicklung-heading">
    <div class="container-page">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-20">

        <!-- Left: Heading + intro -->
        <div class="flex flex-col gap-4 lg:max-w-[38ch] lg:shrink-0">
          <span
            class="font-[family-name:var(--font-body)] text-[0.75rem] font-bold uppercase tracking-[0.1em] text-(--color-primary-400)"
          >
            Direkte Abwicklung
          </span>
          <h2
            id="abwicklung-heading"
            class="m-0 font-[family-name:var(--font-heading)] text-[1.75rem] font-bold leading-[1.2] text-white lg:text-[2.25rem]"
          >
            Unkomplizierte Abrechnung – kein Aufwand für Sie
          </h2>
          <p class="m-0 text-[1rem] leading-[1.8] text-white/70">
            Durch eine Abtretungserklärung rechnen wir die erbrachten Leistungen direkt mit der Pflegekasse ab – Sie müssen sich um nichts kümmern.
          </p>
        </div>

        <!-- Right: The three Keine-points + footnote -->
        <div class="flex flex-col gap-6 lg:pt-1">
          <ul class="m-0 flex flex-col gap-4 pl-0 list-none">
            {[
              "Keine Antragstellung durch Sie notwendig",
              "Keine Abrechnung in Eigenregie",
              "Keine Vorkasse",
            ].map((point) => (
              <li class="flex items-center gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-(--color-primary-500)/20 text-(--color-primary-400)"
                >
                  <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </span>
                <span class="text-[1rem] font-semibold text-white">{point}</span>
              </li>
            ))}
          </ul>
          <p class="m-0 text-[1rem] leading-[1.8] text-white/70">
            Wir übernehmen die komplette Abwicklung mit der Pflegekasse und informieren Sie transparent über die genutzten Leistungen. Bei Fragen stehen wir jederzeit zur Verfügung.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =============================================
       PERSÖNLICHE BERATUNG – closing CTA section
       ============================================= -->
  <section class="wh-section bg-(--color-base-alt)" aria-labelledby="beratung-cta-heading">
    <div class="container-page">
      <div class="flex flex-col items-center gap-6 text-center">
        <div class="flex flex-col gap-3">
          <h2
            id="beratung-cta-heading"
            class="m-0 font-[family-name:var(--font-heading)] text-[1.75rem] font-bold leading-[1.2] text-(--color-dark) lg:text-[2.25rem]"
          >
            Persönliche Beratung in Hamburg
          </h2>
          <p class="m-0 mx-auto max-w-[52ch] text-[1rem] leading-[1.8] text-(--color-dark) opacity-80">
            Welche Leistungen im Einzelfall sinnvoll sind, hängt von den individuellen Bedürfnissen ab. Wir beraten Sie gerne persönlich zu Pflegegrad, Entlastungsbetrag und den Möglichkeiten der Kostenübernahme durch die Pflegekasse.
          </p>
        </div>
        <a
          href="/kontakt"
          class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-8 py-4 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-dark text-[#1b2227] no-underline shadow-[0_4px_20px_rgb(255_183_48/0.3)] transition-all duration-200 hover:bg-(--color-primary-400) hover:shadow-[0_6px_28px_rgb(255_183_48/0.45)] active:scale-[0.98]"
        >
          Jetzt Beratung anfragen
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition-transform duration-200 group-hover:translate-x-1"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <span class="text-[0.875rem] text-(--color-dark) opacity-55">
          Kostenlose Erstberatung – unverbindlich und persönlich
        </span>
      </div>
    </div>
  </section>
</Layout>
