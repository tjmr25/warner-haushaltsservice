---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import pflegebeduerfteBild from '../assets/images/pflegebeduerfte_hero.jpg';

const detailedServices = [
  {
    num: "01",
    title: "Reinigung und Haushaltshilfe",
    desc: "Eine saubere und ordentliche Wohnumgebung trägt wesentlich zum Wohlbefinden bei. Wir unterstützen Sie zuverlässig bei der regelmäßigen Reinigung Ihres Zuhauses, einschließlich:",
    items: [
      "Reinigung von Wohn-, Schlaf-, Küchen- und Sanitärräumen",
      "Staubsaugen, Wischen und Oberflächenreinigung",
      "Unterstützung beim Aufräumen und Ordnung halten",
    ],
  },
  {
    num: "02",
    title: "Unterstützung beim Aufräumen",
    desc: "Gerade im Alltag kann Ordnung schwerfallen. Wir helfen dabei, den Wohnraum übersichtlich und sicher zu gestalten:",
    items: [
      "Gemeinsames Aufräumen von Wohnbereichen",
      "Unterstützung beim Sortieren und Ordnen",
      "Schaffung eines angenehmen und sicheren Wohnumfelds",
    ],
  },
  {
    num: "03",
    title: "Wäschepflege",
    desc: "Auch die Wäschepflege ist für viele Pflegebedürftige eine große Herausforderung. Unsere Unterstützung umfasst:",
    items: [
      "Waschen der Wäsche",
      "Trocknen und Zusammenlegen",
      "Ordnungsgemäßes Verstauen der Kleidung",
    ],
    note: "So sorgen wir für Hygiene, Ordnung und Entlastung im Alltag.",
  },
  {
    num: "04",
    title: "Fensterputzen und Gardinenpflege",
    desc: "Saubere Fenster und frische Gardinen sorgen für mehr Licht und Wohnkomfort, sind jedoch körperlich anstrengend. Wir übernehmen für Sie:",
    items: [
      "Fensterputzen in der Wohnung",
      "Abnehmen und Waschen von Gardinen",
      "Wiederanbringen der Gardinen",
    ],
  },
  {
    num: "05",
    title: "Gesellschaft und Alltagsbegleitung",
    desc: "Neben praktischer Hilfe ist soziale Unterstützung besonders wichtig. Wir nehmen uns Zeit für:",
    items: [
      "Gesellschaft und Gespräche",
      "Gemeinsame Aktivitäten im Alltag",
      "Persönliche Zuwendung und Begleitung",
    ],
    note: "Diese Form der Alltagsbegleitung stärkt das Wohlbefinden, beugt Einsamkeit vor und gibt Sicherheit.",
  },
];
---

<Layout
  title="Pflegebedürftige – Warner Haushaltsservice"
  description="Unterstützung und Entlastung für Pflegebedürftige und ihre Angehörigen in Hamburg."
>
  <PageHero
    eyebrow="Selbstbestimmt zu Hause leben"
    headingHtml="Haushaltshilfe für<br /><span>Pflegebedürftige</span>"
    text="Wenn alltägliche Dinge zur Herausforderung werden, sind wir für Sie da. Wir unterstützen pflegebedürftige Menschen dabei, ihren Alltag so selbstbestimmt und angenehm wie möglich zu gestalten."
    badgeText="Abrechenbar über die Pflegekasse"
    imageSrc={pflegebeduerfteBild}
    imageAlt="Freundliche Alltagsbegleiterin unterstützt eine ältere Dame liebevoll in ihrem Zuhause"
    headingTag="h1"
    imageObjectPositionDesktop="center 35%"
  />

  <!-- =============================================
       UNTERSTÜTZUNG IM ALLTAG SECTION
       ============================================= -->

  <!-- MOBILE / TABLET ONLY (unter lg) -->
  <section
    class="wh-section bg-(--color-base-alt) lg:hidden"
    aria-labelledby="alltag-heading-mobile"
  >
    <div class="container-page">
      <div class="mx-auto flex max-w-3xl flex-col gap-6">
        <div class="flex flex-col gap-3">
          <span
            class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
          >
            Individuelle Alltagshilfe
          </span>
          <h2
            id="alltag-heading-mobile"
            class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark)"
          >
            Unterstützung, wenn der Alltag schwerfällt
          </h2>
          <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
        </div>

        <div class="flex flex-col gap-4">
          <p class="m-0 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85">
            Wir nehmen uns Zeit, hören zu und passen unsere Hilfe individuell an die Bedürfnisse jedes Einzelnen an. Unser Ziel ist es, Entlastung zu schaffen, Sicherheit zu geben und die Lebensqualität zu erhalten – zuverlässig, respektvoll und menschlich.
          </p>
        </div>

        <p class="m-0 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85">
          Gerne beraten wir Sie persönlich zu den Möglichkeiten der Kostenübernahme durch die Pflegekasse und zu unseren Leistungen.
        </p>

        <!-- Qualifications card -->
        <div class="w-full rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] md:w-[60%]">
          <h3 class="m-0 mb-5 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)">
            Qualifikation unserer Mitarbeiterinnen
          </h3>
          <div class="flex flex-col gap-5">
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                Mehrtägige, nach der <strong class="font-semibold text-(--color-dark) opacity-100">Hamburgischen Pflege-Engagement-Verordnung</strong> anerkannte Schulung
              </p>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
              </div>
              <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                Alle Mitarbeiterinnen absolvieren einen <strong class="font-semibold text-(--color-dark) opacity-100">Erste-Hilfe-Kurs</strong>
              </p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="/kontakt"
            class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-7 py-[0.875rem] font-[family-name:var(--font-heading)] text-[1rem] font-bold text-dark text-[#1b2227] no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:border-(--color-primary-400) hover:bg-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
          >
            Kompetent beraten lassen
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DESKTOP ONLY (ab lg) – Split-Grid Layout -->
  <section
    class="wh-section bg-(--color-base-alt) hidden lg:block"
    aria-labelledby="alltag-heading-desktop"
  >
    <div class="container-page">
      <div class="grid grid-cols-[1fr_1.1fr] items-start gap-16 xl:gap-24">
        <!-- LEFT: Intro & Header (Sticky) -->
        <div class="flex flex-col gap-6 lg:sticky lg:top-28">
          <div class="flex flex-col gap-3">
            <span
              class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
            >
              Individuelle Alltagshilfe
            </span>
            <h2
              id="alltag-heading-desktop"
              class="m-0 font-[family-name:var(--font-heading)] text-[2.5rem] leading-[1.2] font-bold text-(--color-dark)"
            >
              Unterstützung, wenn der Alltag schwerfällt
            </h2>
            <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
          </div>

          <p class="m-0 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85 max-w-[48ch]">
            Wir nehmen uns Zeit, hören zu und passen unsere Hilfe individuell an die Bedürfnisse jedes Einzelnen an. Unser Ziel ist es, Entlastung zu schaffen, Sicherheit zu geben und die Lebensqualität zu erhalten – zuverlässig, respektvoll und menschlich.
          </p>

          <p class="m-0 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85 max-w-[48ch]">
            Gerne beraten wir Sie persönlich zu den Möglichkeiten der Kostenübernahme durch die Pflegekasse und zu unseren Leistungen.
          </p>

          <div class="pt-2">
            <a
              href="/kontakt"
              class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-8 py-4 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-dark text-[#1b2227] no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:border-(--color-primary-400) hover:bg-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
            >
              Kompetent beraten lassen
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- RIGHT: Qualifikation Card -->
        <div class="w-full rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-9 shadow-[0_6px_24px_rgb(27_34_39/0.04)]">
          <h3 class="m-0 mb-6 font-[family-name:var(--font-heading)] text-[1.375rem] font-bold text-(--color-dark)">
            Qualifikation unserer Mitarbeiterinnen
          </h3>
          <div class="flex flex-col gap-6">
            <!-- Badge 1 -->
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
              <div>
                <h4 class="m-0 mb-1 font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark)">Anerkannte Schulung</h4>
                <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                  Mehrtägige, nach der <strong class="font-semibold text-(--color-dark) opacity-100">Hamburgischen Pflege-Engagement-Verordnung</strong> anerkannte Schulung.
                </p>
              </div>
            </div>
            <!-- Badge 2 -->
            <div class="flex items-start gap-4 pt-4 border-t border-(--color-secondary)/60">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                </svg>
              </div>
              <div>
                <h4 class="m-0 mb-1 font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark)">Erste-Hilfe-Zertifikat</h4>
                <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                  Alle Mitarbeiterinnen absolvieren regelmäßig einen <strong class="font-semibold text-(--color-dark) opacity-100">Erste-Hilfe-Kurs</strong>.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       UNSERE LEISTUNGEN IM DETAIL SECTION
       ============================================= -->

  <!-- MOBILE / TABLET ONLY (unter lg) -->
  <section
    class="wh-section bg-(--color-base) lg:hidden"
    aria-labelledby="detail-leistungen-heading-mobile"
  >
    <div class="container-page">
      <div class="mb-10 flex flex-col gap-3">
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Umfassende Pflege-Unterstützung
        </span>
        <h2
          id="detail-leistungen-heading-mobile"
          class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark)"
        >
          Unsere Leistungen im Detail
        </h2>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
        <p class="mt-2 m-0 max-w-[65ch] text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
          Diese Leistungen können unkompliziert im Rahmen der Entlastungsleistungen (§ 45b SGB XI) bzw. der Verhinderungspflege genutzt und direkt mit den Pflegekassen abgerechnet werden.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          detailedServices.map((service) => (
            <div class="group relative flex flex-col justify-between rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]">
              <div>
                <div class="mb-3 font-[family-name:var(--font-heading)] text-[2rem] font-extrabold leading-none text-(--color-primary-500)/40">
                  {service.num}
                </div>
                <h3 class="mb-3 m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)">
                  {service.title}
                </h3>
                <p class="mb-5 m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                  {service.desc}
                </p>
                <ul class="mb-4 flex flex-col gap-3 list-none m-0 p-0">
                  {service.items.map((item) => (
                    <li class="flex items-start gap-3 text-[0.9375rem] font-medium leading-[1.6] text-(--color-dark)">
                      <svg
                        class="mt-0.5 h-5 w-5 shrink-0 text-(--color-primary-600)"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {service.note && (
                <p class="mt-4 m-0 border-t border-(--color-secondary)/60 pt-4 text-[0.875rem] italic leading-[1.6] text-(--color-dark) opacity-75">
                  {service.note}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- DESKTOP ONLY (ab lg) – Split-Grid mit 2-Spalten Karten-Raster rechts -->
  <section
    class="wh-section bg-(--color-base) hidden lg:block"
    aria-labelledby="detail-leistungen-heading-desktop"
  >
    <div class="container-page">
      <div class="grid grid-cols-[1fr_2.2fr] items-start gap-16 xl:gap-24">
        <!-- LEFT: Intro & Header (Sticky) -->
        <div class="flex flex-col gap-4 lg:sticky lg:top-28">
          <span
            class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
          >
            Umfassende Pflege-Unterstützung
          </span>
          <h2
            id="detail-leistungen-heading-desktop"
            class="m-0 font-[family-name:var(--font-heading)] text-[2.5rem] leading-[1.2] font-bold text-(--color-dark)"
          >
            Unsere Leistungen im Detail
          </h2>
          <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
          
          <div class="mt-3 rounded-[var(--radius-lg)] border border-(--color-primary-200) bg-(--color-primary-50)/80 p-5">
            <p class="m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-90">
              Diese Leistungen können unkompliziert im Rahmen der Entlastungsleistungen (<strong class="font-semibold text-(--color-dark)">§ 45b SGB XI</strong>) bzw. der Verhinderungspflege genutzt und direkt mit den Pflegekassen abgerechnet werden.
            </p>
          </div>
        </div>

        <!-- RIGHT: 2-Spalten Grid mit den 5 Karten -->
        <div class="grid grid-cols-2 gap-6">
          {
            detailedServices.map((service) => (
              <div class="group relative flex flex-col justify-between rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]">
                <div>
                  <div class="mb-3 font-[family-name:var(--font-heading)] text-[2.25rem] font-extrabold leading-none text-(--color-primary-500)/45">
                    {service.num}
                  </div>
                  <h3 class="mb-3 m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)">
                    {service.title}
                  </h3>
                  <p class="mb-5 m-0 text-[0.9375rem] leading-[1.7] text-(--color-dark) opacity-80">
                    {service.desc}
                  </p>
                  <ul class="mb-4 flex flex-col gap-3 list-none m-0 p-0">
                    {service.items.map((item) => (
                      <li class="flex items-start gap-3 text-[0.9375rem] font-medium leading-[1.6] text-(--color-dark)">
                        <svg
                          class="mt-0.5 h-5 w-5 shrink-0 text-(--color-primary-600)"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                {service.note && (
                  <p class="mt-4 m-0 border-t border-(--color-secondary)/60 pt-4 text-[0.875rem] italic leading-[1.6] text-(--color-dark) opacity-75">
                    {service.note}
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       ABRECHNUNG ÜBER DIE PFLEGEKASSE SECTION
       ============================================= -->

  <!-- MOBILE / TABLET ONLY (unter lg) -->
  <section
    class="wh-section bg-(--color-base-alt) overflow-hidden lg:hidden"
    aria-labelledby="abrechnung-heading-mobile"
  >
    <div class="container-page">
      <div
        class="relative mb-14 overflow-hidden rounded-[var(--radius-xl)] bg-gradient-to-br from-(--color-primary-400) via-(--color-primary-500) to-amber-400 p-8 md:p-12 shadow-[0_16px_48px_rgb(255_183_48/0.35)]"
      >
        <svg
          aria-hidden="true"
          class="absolute right-6 top-1/2 -translate-y-1/2 opacity-[0.08]"
          width="220"
          height="220"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="none"
        >
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>

        <div class="relative z-10 flex flex-col gap-4">
          <div class="flex shrink-0 flex-col items-start gap-2">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white/30 backdrop-blur-sm">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <span class="mt-1 font-[family-name:var(--font-body)] text-[0.75rem] font-bold uppercase tracking-[0.1em] text-white/80">
              Offiziell anerkannt
            </span>
          </div>

          <div class="flex flex-col gap-2">
            <h2
              id="abrechnung-heading-mobile"
              class="m-0 font-[family-name:var(--font-heading)] text-[1.625rem] font-bold leading-[1.2] text-(--color-dark)"
            >
              Abrechnung über die Pflegekasse – einfach und direkt
            </h2>
            <p class="m-0 text-[1rem] leading-[1.7] text-(--color-dark)/85">
              Wir sind von der Stadt Hamburg anerkannt und berechtigt, unsere Leistungen direkt mit den Pflegekassen abzurechnen. Für Pflegebedürftige mit Pflegegrad bedeutet das: unkomplizierter Zugang zu professioneller Unterstützung, finanziert durch die Pflegekasse.
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-8 max-w-[72ch]">
        <div class="flex flex-col gap-4 border-l-2 border-(--color-primary-400) pl-6">
          <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark)">
            Warum die Anerkennung zählt
          </h3>
          <p class="m-0 text-[1rem] leading-[1.8] text-(--color-dark) opacity-85">
            Das Anerkennungsverfahren der Stadt Hamburg ist umfassend und anspruchsvoll – es stellt sicher, dass nur Anbieter zugelassen werden, die die gesetzlichen Anforderungen dauerhaft erfüllen. Für Pflegebedürftige und ihre Familien bedeutet das: Transparenz, geprüfte Qualität und Vertrauen.
          </p>
          <p class="m-0 text-[1rem] leading-[1.8] text-(--color-dark) opacity-85">
