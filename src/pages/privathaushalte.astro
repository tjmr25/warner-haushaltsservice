---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import privathaushalteHero from '../assets/images/privathaushalte_hero.jpg';
---

<Layout
  title="Haushaltshilfe für Privathaushalte – Warner Haushaltsservice"
  description="Professionelle Haushaltshilfe für Privathaushalte in Hamburg – für Familien, Berufstätige und Senioren. Entlasten Sie sich im Alltag mit Warner Haushaltsservice."
>
  <PageHero
    eyebrow="Seit über 20 Jahren in Hamburg"
    headingHtml="Haushaltshilfe für <span>Privathaushalte</span>"
    text="Entlasten Sie sich im Alltag mit unserer professionellen Haushaltshilfe – ganz gleich, in welcher Lebensphase Sie sich befinden."
    imageSrc={privathaushalteHero}
    imageAlt="Professionelle Haushaltshilfe reinigt ein helles, gemütliches Wohnzimmer in Hamburg"
    headingTag="h1"
    imageObjectPosition="bottom"
    imageObjectPositionDesktop="center 60%"
  />

  <!-- =============================================
       FÜR WEN WIR DA SIND – ZIELGRUPPEN SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base-alt)"
    aria-labelledby="zielgruppen-heading"
  >
    <div class="container-page">
      <!-- Section Header -->
      <div class="mb-12 flex flex-col gap-3 lg:mb-16">
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Für jeden Lebensalltag
        </span>
        <h2
          id="zielgruppen-heading"
          class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.75rem]"
        >
          Wer profitiert?
        </h2>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
      </div>

      <!-- Cards Grid -->
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">

        <!-- Card 1: Familien -->
        <div
          class="group relative flex flex-col gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]"
        >
          <!-- Icon Badge -->
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700) transition-colors duration-300 group-hover:bg-(--color-primary-200)/80"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <!-- Content -->
          <div class="flex flex-col gap-2">
            <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">
              Familien
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
              Gewinnen Sie mehr Zeit füreinander – für gemeinsame Momente und einen entspannteren Alltag.
            </p>
          </div>
        </div>

        <!-- Card 2: Berufstätige -->
        <div
          class="group relative flex flex-col gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]"
        >
          <!-- Icon Badge -->
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700) transition-colors duration-300 group-hover:bg-(--color-primary-200)/80"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <!-- Content -->
          <div class="flex flex-col gap-2">
            <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">
              Berufstätige
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
              Schalten Sie nach einem langen Arbeitstag ab – anstatt sich um Haushaltspflichten zu kümmern.
            </p>
          </div>
        </div>

        <!-- Card 3: Senioren -->
        <div
          class="group relative flex flex-col gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]"
        >
          <!-- Icon Badge -->
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700) transition-colors duration-300 group-hover:bg-(--color-primary-200)/80"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="5" r="3"></circle>
              <path d="M6.5 17.5c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5"></path>
              <line x1="12" y1="8" x2="12" y2="12"></line>
            </svg>
          </div>
          <!-- Content -->
          <div class="flex flex-col gap-2">
            <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">
              Senioren
            </h3>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
              Erhalten Sie zuverlässige Unterstützung, die den Alltag erleichtert und ein selbstbestimmtes Leben in den eigenen vier Wänden ermöglicht.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =============================================
       WAS WIR ÜBERNEHMEN SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base)"
    aria-labelledby="leistungen-heading"
  >
    <div class="container-page">
      <div class="mx-auto max-w-2xl">
        <!-- Eyebrow -->
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Unser Angebot für Sie
        </span>

        <!-- Heading -->
        <h2
          id="leistungen-heading"
          class="mt-3 mb-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.5rem]"
        >
          Unsere Leistungen für Sie im Einzelnen
        </h2>

        <!-- Accent line -->
        <div class="mt-4 h-1 w-12 rounded-full bg-(--color-primary-500)"></div>

        <!-- Description -->
        <p class="mt-6 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85">
          Unser erfahrenes Team kümmert sich um Ordnung und die gründliche Reinigung Ihres Zuhauses, unterstützt Sie bei der Wäschepflege und übernimmt das Bügeln.
        </p>

        <!-- Services List -->
        <ul class="mt-8 flex flex-col divide-y divide-(--color-secondary)/60 border-t border-(--color-secondary)/60 list-none m-0 p-0">
          {[
            "Aufräumen",
            "Blumen gießen",
            "Reinigung",
            "Wäschepflege",
            "Bügeln",
          ].map((item) => (
            <li class="flex items-center gap-4 py-4 text-[1rem] font-semibold text-(--color-dark) font-[family-name:var(--font-heading)]">
              <span
                class="flex h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-primary-500)"
                aria-hidden="true"
              ></span>
              {item}
            </li>
          ))}
        </ul>

        <!-- CTA Button -->
        <div class="mt-10">
          <a
            href="/kontakt"
            class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-8 py-4 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark) no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:bg-(--color-primary-400) hover:border-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
          >
            Jetzt anfragen
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="transition-transform duration-200 group-hover:translate-x-1"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================
       SO GEHT'S – TIMELINE SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base-alt)"
    aria-labelledby="prozess-heading"
  >
    <div class="container-page">
      <!-- Section Header -->
      <div class="mb-14 flex flex-col gap-3 lg:mb-20">
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Ihr Einstieg bei uns
        </span>
        <h2
          id="prozess-heading"
          class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.75rem]"
        >
          So einfach geht's
        </h2>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
      </div>

      <!-- Timeline -->
      <div class="relative mx-auto max-w-2xl">

        <!-- Vertical connecting line -->
        <div
          class="absolute left-[23px] top-12 bottom-12 w-0.5 bg-gradient-to-b from-(--color-primary-300) via-(--color-primary-400) to-(--color-primary-200) rounded-full lg:left-[27px]"
          aria-hidden="true"
        ></div>

        <!-- Steps -->
        <ol class="relative flex flex-col gap-0 list-none m-0 p-0">

          <!-- Step 1 -->
          <li class="relative flex gap-6 pb-12 lg:gap-8 lg:pb-14">
            <!-- Number Badge -->
            <div class="relative z-[1] flex-shrink-0">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-(--color-primary-500) bg-(--color-base-alt) font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark) lg:h-14 lg:w-14 lg:text-[1.25rem]"
              >
                1
              </div>
            </div>
            <!-- Content -->
            <div class="flex flex-col gap-2 pt-2 lg:pt-3">
              <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) lg:text-[1.375rem]">
                Kostenloses Erstgespräch
              </h3>
              <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch]">
                Bei einem unverbindlichen Erstbesuch in Ihren Räumlichkeiten besprechen wir, welche Unterstützung Sie genau brauchen.
              </p>
            </div>
          </li>

          <!-- Step 2 -->
          <li class="relative flex gap-6 pb-12 lg:gap-8 lg:pb-14">
            <!-- Number Badge -->
            <div class="relative z-[1] flex-shrink-0">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-(--color-primary-500) bg-(--color-base-alt) font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark) lg:h-14 lg:w-14 lg:text-[1.25rem]"
              >
                2
              </div>
            </div>
            <!-- Content -->
            <div class="flex flex-col gap-2 pt-2 lg:pt-3">
              <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) lg:text-[1.375rem]">
                Maßgeschneidertes Paket
              </h3>
              <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch]">
                Wir beraten Sie, welches Zeitpaket für Sie und Ihre Bedürfnisse das perfekte ist.
              </p>
            </div>
          </li>

          <!-- Step 3 -->
          <li class="relative flex gap-6 lg:gap-8">
            <!-- Number Badge -->
            <div class="relative z-[1] flex-shrink-0">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-(--color-primary-500) bg-(--color-base-alt) font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark) lg:h-14 lg:w-14 lg:text-[1.25rem]"
              >
                3
              </div>
            </div>
            <!-- Content -->
            <div class="flex flex-col gap-2 pt-2 lg:pt-3">
              <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) lg:text-[1.375rem]">
                Individuelle Vorbereitung
              </h3>
              <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch]">
                Wir notieren Ihre Wünsche und die Besonderheiten in Ihrem Zuhause ganz genau und bereiten unsere Mitarbeiterinnen individuell auf diese vor.
              </p>
            </div>
          </li>

        </ol>
      </div>
    </div>
  </section>

  <!-- =============================================
       NOVA RAUMPFLEGE PARTNER SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base)"
    aria-labelledby="nova-heading"
  >
    <div class="container-page">
      <!-- Section Header -->
      <div class="mb-10 flex flex-col gap-3 lg:mb-12">
        <span
          class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase"
        >
          Unser Partner
        </span>
        <h2
          id="nova-heading"
          class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.75rem]"
        >
          Weitere Leistungen mit NOVA Raumpflege
        </h2>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
        <p class="mt-2 max-w-[65ch] text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-80">
          Für Leistungen, die über unsere Haushaltshilfe hinausgehen, arbeiten wir eng mit unserem Partner NOVA Raumpflege zusammen.
        </p>
      </div>

      <!-- Services Unified Big Container Card -->
      <div
        class="overflow-hidden rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-6 md:p-8 lg:p-10 shadow-[0_4px_24px_rgb(27_34_39/0.03)]"
      >
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-0 md:divide-x md:divide-(--color-secondary)/80">

          <!-- Item 1: Büroreinigung -->
          <div class="flex flex-col gap-3 md:px-6 lg:px-8 first:md:pl-0">
            <div class="flex items-center gap-3">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-primary-500)" aria-hidden="true"></span>
              <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">
                Büroreinigung
              </h3>
            </div>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
              Für makellose Arbeitsumgebungen verlassen Sie sich auf professionelle Büroreinigungsdienste. Unsere Partner der NOVA Raumpflege sorgen dafür, dass Ihre Arbeitsräume immer einladend und sauber sind.
            </p>
          </div>

          <!-- Item 2: Glasreinigung -->
          <div class="flex flex-col gap-3 pt-6 border-t border-(--color-secondary)/80 md:pt-0 md:border-t-0 md:px-6 lg:px-8">
            <div class="flex items-center gap-3">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-primary-500)" aria-hidden="true"></span>
              <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">
                Glasreinigung
              </h3>
            </div>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
              Bringen Sie mit Fachleuten für Glasreinigung Ihre Fenster zum Strahlen. Unsere Partner bieten professionelle Glasreinigung für klare und glänzende Oberflächen.
            </p>
          </div>

          <!-- Item 3: Sonderreinigung -->
          <div class="flex flex-col gap-3 pt-6 border-t border-(--color-secondary)/80 md:pt-0 md:border-t-0 md:px-6 lg:px-8 last:md:pr-0">
            <div class="flex items-center gap-3">
              <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-primary-500)" aria-hidden="true"></span>
              <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">
                Sonderreinigung
              </h3>
            </div>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">
              Für spezielle Reinigungsanforderungen bieten wir maßgeschneiderte Lösungen. NOVA Raumpflege steht Ihnen zur Verfügung, um auch die anspruchsvollsten Reinigungsaufgaben zu bewältigen.
            </p>
          </div>

        </div>
      </div>

      <!-- CTA to NOVA -->
      <div class="mt-8">
        <a
          href="https://nova-raumpflege.de/"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-7 py-[0.875rem] font-[family-name:var(--font-heading)] text-base font-bold text-dark text-[#1b2227] no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:border-(--color-primary-400) hover:bg-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
        >
          NOVA Raumpflege besuchen
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
