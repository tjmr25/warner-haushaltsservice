---
import Layout from '../layouts/Layout.astro';

const services = [
  { label: 'Aufräumen'    },
  { label: 'Blumen gießen'},
  { label: 'Reinigung'    },
  { label: 'Wäschepflege' },
  { label: 'Bügeln'       },
];

const partnerServices = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Büroreinigung',
    text: 'Für makellose Arbeitsumgebungen verlassen Sie sich auf professionelle Büroreinigungsdienste. Unsere Partner der Nova Raumpflege sorgen dafür, dass Ihre Arbeitsräume immer einladend und sauber sind.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
    title: 'Glasreinigung',
    text: 'Bringen Sie mit Fachleuten für Glasreinigung Ihre Fenster zum Strahlen. Unsere Partner bieten professionelle Glasreinigung für klare und glänzende Oberflächen.',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Sonderreinigung',
    text: 'Für spezielle Reinigungsanforderungen bieten sie maßgeschneiderte Lösungen. Nova Raumpflege steht Ihnen zur Verfügung, um auch die anspruchsvollsten Reinigungsaufgaben zu bewältigen.',
  },
];

const steps = [
  {
    num: '1',
    title: 'Kostenloses Erstgespräch',
    text: 'Bei einem unverbindlichen Erstbesuch in Ihren Räumlichkeiten besprechen wir, welche Unterstützung Sie genau brauchen.',
  },
  {
    num: '2',
    title: 'Maßgeschneidertes Paket',
    text: 'Wir beraten Sie, welches Zeitpaket für Sie und Ihre Bedürfnisse das perfekte ist.',
  },
  {
    num: '3',
    title: 'Individuelle Vorbereitung',
    text: 'Wir notieren Ihre Wünsche und die Besonderheiten in Ihrem Zuhause ganz genau und bereiten unsere Mitarbeiterinnen individuell auf diese vor.',
  },
];
---

<Layout
  title="Haushaltshilfe für Privathaushalte"
  description="Professionelle Haushaltshilfe in Hamburg für Familien, Berufstätige und Senioren. Reinigung, Wäschepflege, Bügeln – maßgeschneidert für Ihren Alltag. Warner Haushaltsservice."
>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero" aria-labelledby="page-hero-heading">
    <div class="container-content page-hero-inner">
      <div class="page-hero-text">
        <a href="/" class="breadcrumb" aria-label="Zurück zur Startseite">← Startseite</a>
        <p class="section-label">Für Familien, Berufstätige & Senioren</p>
        <h1 id="page-hero-heading">
          Haushaltshilfe für<br />
          <span class="highlight-italic">Privathaushalte</span>
        </h1>
        <div class="accent-divider"></div>
        <p class="page-hero-sub">
          Entlasten Sie sich im Alltag mit unserer professionellen Haushaltshilfe –
          ganz gleich, in welcher Lebensphase Sie sich befinden.
        </p>
        <div class="hero-ctas">
          <a href="/kontakt" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Erstgespräch anfragen
          </a>
          <a href="tel:+4940298125400" class="btn-secondary">
            040 / 29 81 25 40
          </a>
        </div>
      </div>
      <div class="page-hero-image" aria-hidden="true">
        <img
          src="/images/service-privat.jpg"
          alt="Gepflegtes, helles Hamburger Wohnzimmer nach professioneller Reinigung"
          width="580"
          height="440"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ===== TARGET GROUPS ===== -->
  <section class="section-padding bg-warm-light" aria-labelledby="target-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">Wer profitiert?</p>
        <h2 id="target-heading">Für jeden Lebensabschnitt die richtige Unterstützung</h2>
        <div class="accent-divider" style="margin: 1rem auto;"></div>
      </header>

      <div class="target-grid">
        <div class="target-card">
          <div class="target-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3>Familien</h3>
          <p>Gewinnen Sie mehr Zeit füreinander – für gemeinsame Momente und einen entspannteren Alltag.</p>
        </div>

        <div class="target-card">
          <div class="target-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
          </div>
          <h3>Berufstätige</h3>
          <p>Schalten Sie nach einem langen Arbeitstag ab – anstatt sich um Haushaltspflichten zu kümmern.</p>
        </div>

        <div class="target-card">
          <div class="target-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 014-4h4a4 4 0 014 4v2"/></svg>
          </div>
          <h3>Senioren</h3>
          <p>Erhalten Sie zuverlässige Unterstützung, die den Alltag erleichtert und ein selbstbestimmtes Leben in den eigenen vier Wänden ermöglicht.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES LIST ===== -->
  <section class="section-padding bg-warm-mid" aria-labelledby="services-heading">
    <div class="container-content services-layout">

      <div class="services-text">
        <p class="section-label">Was wir übernehmen</p>
        <h2 id="services-heading">Unsere Leistungen für Sie im Einzelnen</h2>
        <div class="accent-divider"></div>
        <p>
          Unser erfahrenes Team kümmert sich um Ordnung und die gründliche
          Reinigung Ihres Zuhauses, unterstützt Sie bei der Wäschepflege und
          übernimmt das Bügeln.
        </p>

        <ul class="service-items" role="list">
          {services.map(s => (
            <li>
              <span class="service-dot" aria-hidden="true"></span>
              {s.label}
            </li>
          ))}
        </ul>

        <a href="/kontakt" class="btn-primary" style="margin-top: 2rem; display: inline-flex;">
          Jetzt anfragen
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="services-image-wrap" aria-hidden="true">
        <img
          src="/images/hero-home.jpg"
          alt="Professionelle Haushaltshilfe beim Reinigen"
          width="540"
          height="420"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="section-padding bg-warm-light" aria-labelledby="steps-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">So einfach geht's</p>
        <h2 id="steps-heading">So funktioniert's</h2>
        <div class="accent-divider" style="margin: 1rem auto;"></div>
      </header>

      <div class="steps-grid">
        {steps.map(step => (
          <div class="step-item">
            <div class="step-num" aria-hidden="true">{step.num}</div>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PARTNER SERVICES ===== -->
  <section class="section-padding bg-warm-mid" aria-labelledby="partner-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">Unser Partnernetzwerk</p>
        <h2 id="partner-heading">Partnerleistungen</h2>
        <div class="accent-divider" style="margin: 1rem auto;"></div>
        <p class="section-intro" style="color: #5b3824;">
          Für spezielle Anforderungen arbeiten wir mit unserem bewährten Partner
          <strong>NOVA Raumpflege</strong> zusammen.
        </p>
      </header>

      <div class="partner-grid">
        {partnerServices.map(ps => (
          <div class="partner-card card">
            <div class="partner-icon" set:html={ps.icon}></div>
            <h3>{ps.title}</h3>
            <p>{ps.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FINAL CTA ===== -->
  <section class="final-cta-private" aria-labelledby="cta-priv-heading">
    <div class="container-content final-cta-inner">
      <h2 id="cta-priv-heading">
        Bereit für mehr Zeit für sich selbst?
      </h2>
      <p>
        Kontaktieren Sie uns noch heute. Unser freundliches und kompetentes Team
        steht Ihnen jederzeit zur Verfügung, um Ihre Fragen zu beantworten und
        gemeinsam mit Ihnen maßgeschneiderte Lösungen zu finden.
      </p>
      <div class="final-cta-buttons">
        <a href="/kontakt" class="btn-primary">Jetzt Beratung anfordern</a>
        <a href="tel:+4940298125400" class="final-cta-tel">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
          040 / 29 81 25 40
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  main { padding-top: 4.5rem; }
  @media (min-width: 1024px) { main { padding-top: 5rem; } }

  /* ===== BREADCRUMB ===== */
  .breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: #7d6e5e;
    text-decoration: none;
    margin-bottom: 1rem;
    transition: color 0.2s ease;
  }
  .breadcrumb:hover { color: #2a2018; }

  /* ===== PAGE HERO ===== */
  .page-hero {
    background-color: #fbf9f4;
    padding-top: 3rem;
    padding-bottom: 0;
    overflow: hidden;
  }

  .page-hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-bottom: 3rem;
  }

  @media (min-width: 1024px) {
    .page-hero-inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
  }

  .page-hero-text h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin: 0.5rem 0 0;
    line-height: 1.2;
    color: #2a2018;
  }

  .highlight-italic {
    color: #ffb730;
    font-style: italic;
    font-family: "Newsreader", Georgia, serif;
  }

  .page-hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #3d322a;
    margin: 0 0 1.75rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .page-hero-image {
    display: none;
  }

  @media (min-width: 768px) {
    .page-hero-image {
      display: block;
    }
  }

  .page-hero-image img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: 1.25rem;
    display: block;
  }

  @media (min-width: 1024px) {
    .page-hero-image img { height: 460px; }
  }

  /* ===== SECTION HEADER ===== */
  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .section-header h2 {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    margin: 0;
  }
  .section-intro {
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ===== TARGET GROUPS ===== */
  .target-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) { .target-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .target-grid { grid-template-columns: repeat(3, 1fr); } }

  .target-card {
    background-color: #fbf9f4;
    border: 1px solid #e8e2d6;
    border-radius: 1rem;
    padding: 2rem;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .target-card:hover {
    box-shadow: 0 8px 32px rgba(42, 32, 24, 0.09);
    transform: translateY(-3px);
  }

  .target-icon {
    width: 3rem;
    height: 3rem;
    background-color: #fff9eb;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .target-card h3 {
    font-size: 1.125rem;
    margin: 0 0 0.625rem;
    color: #2a2018;
  }

  .target-card p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #5b3824;
    margin: 0;
  }

  /* ===== SERVICES LAYOUT ===== */
  .services-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .services-layout { grid-template-columns: 1fr 1fr; }
  }

  .services-text h2 {
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    margin: 0.5rem 0 0;
  }
  .services-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: #5b3824;
    margin: 0 0 1.5rem;
  }

  .service-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .service-items li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid #e8e2d6;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #2a2018;
    transition: padding-left 0.2s ease;
  }
  .service-items li:last-child { border-bottom: none; }
  .service-items li:hover { padding-left: 0.375rem; }

  .service-dot {
    width: 0.625rem;
    height: 0.625rem;
    background-color: #ffb730;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .services-image-wrap img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    border-radius: 1.25rem;
    display: block;
  }
  @media (min-width: 1024px) {
    .services-image-wrap { display: block; }
    .services-image-wrap img { height: 440px; }
  }

  /* ===== STEPS ===== */
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .steps-grid { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  }

  .step-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .step-item { align-items: center; text-align: center; }
  }

  .step-num {
    width: 3rem;
    height: 3rem;
    background-color: #ffb730;
    color: #2a2018;
    font-size: 1.25rem;
    font-weight: 800;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-content h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.5rem;
    color: #2a2018;
  }
  .step-content p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #5b3824;
    margin: 0;
  }

  /* ===== PARTNER SERVICES ===== */
  .partner-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) { .partner-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .partner-grid { grid-template-columns: repeat(3, 1fr); } }

  .partner-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .partner-icon {
    width: 3rem;
    height: 3rem;
    background-color: #fff9eb;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffb730;
  }

  .partner-card h3 {
    font-size: 1.0625rem;
    margin: 0;
    color: #2a2018;
  }
  .partner-card p {
    font-size: 0.9rem;
    line-height: 1.65;
    color: #5b3824;
    margin: 0;
  }

  /* ===== FINAL CTA ===== */
  .final-cta-private {
    background-color: #2a2018;
    padding: 4rem 0;
  }
  .final-cta-inner {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }
  .final-cta-private h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
    color: #ecd8b5;
    margin: 0 0 1rem;
  }
  .final-cta-private p {
    font-size: 1rem;
    color: #b8ab9a;
    line-height: 1.7;
    margin: 0 0 2rem;
  }
  .final-cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
  .final-cta-tel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ecd8b5;
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .final-cta-tel:hover { color: #ffb730; }
</style>
