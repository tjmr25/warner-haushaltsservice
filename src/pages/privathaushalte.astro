---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import havKueche from '../assets/images/Hav Küche.jpg';
const serviceSchema = {
  '@type': 'Service',
  name: 'Haushaltshilfe und Unterstützung bei der Haushaltsführung für Privathaushalte in Hamburg',
  serviceType: 'Haushaltsnahe Dienstleistungen für Privatkunden nach § 35a EStG',
  provider: {
    '@id': 'https://warner-hamburg.de/#organization',
  },
  areaServed: {
    '@type': 'City',
    name: 'Hamburg',
  },
  description:
    'Professionelle Unterstützung bei der Haushaltsführung, Wäscheservice und Ordnung für Familien, Berufstätige und Senioren in Hamburg. Steuerlich absetzbar (20 % Erstattung nach § 35a EStG).',
};
---

<Layout
  title="Haushaltshilfe für Privathaushalte Hamburg | Warner Haushaltsservice"
  description="Zuverlässige Haushaltshilfe & Unterstützung bei der Haushaltsführung für Privathaushalte in Hamburg. Für Familien, Berufstätige & Senioren – 20 % steuerlich absetzbar (§ 35a EStG). Jetzt anfragen!"
  extraSchema={serviceSchema}
>
  <PageHero
    eyebrow="Seit über 25 Jahren in Hamburg"
    headingHtml="Haushaltshilfe für<br /><span>Privathaushalte</span>"
    text="Entlasten Sie sich im Alltag mit unserer professionellen Haushaltshilfe – ganz gleich, in welcher Lebensphase Sie sich befinden."
    imageSrc={havKueche}
    imageAlt="Eine Haushaltshilfe der Warner Haushaltsservice GmbH wischt sorgfältig die Arbeitsfläche in einer modernen Küche in Hamburg"
    headingTag="h1"
    imageObjectPosition="center 30%"
    imageObjectPositionDesktop="center 35%"
  />

  <!-- =============================================
       DESKTOP: Zielgruppen + Leistungen SPLIT LAYOUT
       MOBILE: Zielgruppen oben, Leistungen darunter
       ============================================= -->

  <!-- MOBILE ONLY: Zielgruppen Section -->
  <section
    class="wh-section bg-(--color-base-alt) lg:hidden"
    aria-labelledby="zielgruppen-heading-mobile"
  >
    <div class="container-page">
      <div class="mb-12 flex flex-col gap-3">
        <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase">
          Für jeden Lebensalltag
        </span>
        <h2
          id="zielgruppen-heading-mobile"
          class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark)"
        >
          Wer profitiert?
        </h2>
        <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
      </div>
      <div class="grid grid-cols-1 gap-6">
        <!-- Card 1: Familien -->
        <div class="group relative flex flex-col gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700) transition-colors duration-300 group-hover:bg-(--color-primary-200)/80">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">Familien</h3>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">Gewinnen Sie mehr Zeit füreinander – für gemeinsame Momente und einen entspannteren Alltag.</p>
          </div>
        </div>
        <!-- Card 2: Berufstätige -->
        <div class="group relative flex flex-col gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700) transition-colors duration-300 group-hover:bg-(--color-primary-200)/80">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            </svg>
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">Berufstätige</h3>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">Schalten Sie nach einem langen Arbeitstag ab – anstatt sich um Haushaltspflichten zu kümmern.</p>
          </div>
        </div>
        <!-- Card 3: Senioren -->
        <div class="group relative flex flex-col gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white p-7 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-1 hover:border-(--color-primary-300) hover:shadow-[0_12px_32px_rgb(255_183_48/0.18)]">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700) transition-colors duration-300 group-hover:bg-(--color-primary-200)/80">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="5" r="3"></circle>
              <path d="M6.5 17.5c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5"></path>
              <line x1="12" y1="8" x2="12" y2="12"></line>
            </svg>
          </div>
          <div class="flex flex-col gap-2">
            <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark)">Senioren</h3>
            <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80">Erhalten Sie zuverlässige Unterstützung, die den Alltag erleichtert und ein selbstbestimmtes Leben in den eigenen vier Wänden ermöglicht.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MOBILE ONLY: Leistungen Section -->
  <section
    class="wh-section bg-(--color-base) lg:hidden"
    aria-labelledby="leistungen-heading-mobile"
  >
    <div class="container-page">
      <div class="mx-auto max-w-2xl">
        <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase">
          Unser Angebot für Sie
        </span>
        <h2
          id="leistungen-heading-mobile"
          class="mt-3 mb-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark)"
        >
          Unsere Leistungen für Sie im Einzelnen
        </h2>
        <div class="mt-4 h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
        <p class="mt-6 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85">
          Unser erfahrenes Team kümmert sich um Ordnung und die zuverlässige Unterstützung bei der Haushaltsführung, unterstützt Sie bei der Wäschepflege und übernimmt das Bügeln.
        </p>
        <ul class="mt-8 flex flex-col divide-y divide-(--color-secondary)/60 border-t border-(--color-secondary)/60 list-none m-0 p-0">
          {["Aufräumen", "Blumen gießen", "Unterstützung bei der Haushaltsführung", "Wäschepflege", "Bügeln"].map((item) => (
            <li class="flex items-center gap-4 py-4 text-[1rem] font-semibold text-(--color-dark) font-[family-name:var(--font-heading)]">
              <span class="flex h-2.5 w-2.5 shrink-0 rounded-full bg-(--color-primary-500)" aria-hidden="true"></span>
              {item}
            </li>
          ))}
        </ul>
        <div class="mt-10">
          <a
            href="/kontakt"
            class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-8 py-4 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark) no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:bg-(--color-primary-400) hover:border-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
          >
            Jetzt anfragen
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DESKTOP ONLY: Zielgruppen + Leistungen als Split-Layout -->
  <section
    class="wh-section bg-(--color-base-alt) hidden lg:block"
    aria-labelledby="zielgruppen-heading"
  >
    <div class="container-page">
      <div class="grid grid-cols-[1fr_1.1fr] items-start gap-20 xl:gap-28">

        <!-- LEFT: Zielgruppen Header + Cards -->
        <div class="flex flex-col gap-10 lg:sticky lg:top-28">
          <div class="flex flex-col gap-3">
            <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase">
              Für jeden Lebensalltag
            </span>
            <h2
              id="zielgruppen-heading"
              class="m-0 font-[family-name:var(--font-heading)] text-[2.5rem] leading-[1.2] font-bold text-(--color-dark)"
            >
              Wer profitiert?
            </h2>
            <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
            <p class="mt-2 max-w-[44ch] text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-80">
              Ob Familien, Berufstätige oder Senioren – wir unterstützen jeden, der Entlastung im Alltag braucht.
            </p>
          </div>

          <!-- Zielgruppen als schmale Zeilen-Karten -->
          <div class="flex flex-col gap-4">
            <!-- Familien -->
            <div class="group flex items-center gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white px-6 py-5 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-0.5 hover:border-(--color-primary-300) hover:shadow-[0_8px_24px_rgb(255_183_48/0.15)]">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div>
                <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark)">Familien</h3>
                <p class="m-0 mt-0.5 text-[0.875rem] leading-[1.6] text-(--color-dark) opacity-75">Mehr Zeit für gemeinsame Momente statt Hausarbeit.</p>
              </div>
            </div>
            <!-- Berufstätige -->
            <div class="group flex items-center gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white px-6 py-5 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-0.5 hover:border-(--color-primary-300) hover:shadow-[0_8px_24px_rgb(255_183_48/0.15)]">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
              </div>
              <div>
                <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark)">Berufstätige</h3>
                <p class="m-0 mt-0.5 text-[0.875rem] leading-[1.6] text-(--color-dark) opacity-75">Nach dem langen Arbeitstag einfach abschalten.</p>
              </div>
            </div>
            <!-- Senioren -->
            <div class="group flex items-center gap-5 rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white px-6 py-5 shadow-[0_4px_20px_rgb(27_34_39/0.03)] transition-all duration-300 hover:-translate-y-0.5 hover:border-(--color-primary-300) hover:shadow-[0_8px_24px_rgb(255_183_48/0.15)]">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-[var(--radius-lg)] border border-(--color-primary-200)/60 bg-(--color-primary-100) text-(--color-primary-700)">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="5" r="3"></circle>
                  <path d="M6.5 17.5c0-3.038 2.462-5.5 5.5-5.5s5.5 2.462 5.5 5.5"></path>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                </svg>
              </div>
              <div>
                <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.0625rem] font-bold text-(--color-dark)">Senioren</h3>
                <p class="m-0 mt-0.5 text-[0.875rem] leading-[1.6] text-(--color-dark) opacity-75">Selbstbestimmtes Leben in den eigenen vier Wänden.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Leistungen Card -->
        <div class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <h2
              id="leistungen-heading"
              class="m-0 font-[family-name:var(--font-heading)] text-[1.5rem] leading-[1.25] font-bold text-(--color-dark)"
            >
              Unsere Leistungen für Sie im Einzelnen
            </h2>
            <div class="h-1 w-10 rounded-full bg-(--color-primary-500)"></div>
            <p class="mt-1 text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-85">
              Unser erfahrenes Team kümmert sich um Ordnung und die zuverlässige Unterstützung bei der Haushaltsführung, unterstützt Sie bei der Wäschepflege und übernimmt das Bügeln.
            </p>
          </div>

          <!-- Leistungen als schöne Liste in einer Karte -->
          <div class="rounded-[var(--radius-xl)] border border-(--color-secondary)/80 bg-white shadow-[0_4px_24px_rgb(27_34_39/0.04)] overflow-hidden">
            {["Aufräumen", "Blumen gießen", "Unterstützung bei der Haushaltsführung", "Wäschepflege", "Bügeln"].map((item, i) => (
              <div class={`flex items-center gap-5 px-8 py-5 ${i > 0 ? "border-t border-(--color-secondary)/60" : ""}`}>
                <span class="flex h-3 w-3 shrink-0 rounded-full bg-(--color-primary-500)" aria-hidden="true"></span>
                <span class="font-[family-name:var(--font-heading)] text-[1.0625rem] font-semibold text-(--color-dark)">{item}</span>
              </div>
            ))}
          </div>

          <div>
            <a
              href="/kontakt"
              class="group inline-flex items-center gap-2 rounded-[var(--radius-lg)] border-2 border-(--color-primary-500) bg-(--color-primary-500) px-8 py-4 font-[family-name:var(--font-heading)] text-[1rem] font-bold text-(--color-dark) no-underline shadow-[0_4px_16px_rgb(255_183_48/0.3)] transition-all duration-200 hover:bg-(--color-primary-400) hover:border-(--color-primary-400) hover:shadow-[0_6px_22px_rgb(255_183_48/0.45)] active:scale-[0.98]"
            >
              Jetzt anfragen
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =============================================
       SO GEHT'S – TIMELINE SECTION
       Mobile: 1-Spalte, Desktop: Split mit sticky Header links
       ============================================= -->
  <section
    class="wh-section bg-(--color-base)"
    aria-labelledby="prozess-heading"
  >
    <div class="container-page">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">

        <!-- LEFT: Sticky Header (Desktop) / Normal (Mobile) -->
        <div class="lg:sticky lg:top-28 flex flex-col gap-4">
          <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase">
            Ihr Einstieg bei uns
          </span>
          <h2
            id="prozess-heading"
            class="m-0 font-[family-name:var(--font-heading)] text-[2rem] leading-[1.2] font-bold text-(--color-dark) lg:text-[2.5rem]"
          >
            So einfach geht's
          </h2>
          <div class="h-1 w-12 rounded-full bg-(--color-primary-500)"></div>
          <p class="mt-2 max-w-[44ch] text-[1.0625rem] leading-[1.8] text-(--color-dark) opacity-80">
            Vom ersten Gespräch bis zum ersten Einsatz – wir begleiten Sie Schritt für Schritt.
          </p>
        </div>

        <!-- RIGHT: Timeline Steps -->
        <div class="relative">
          <!-- Vertical connecting line -->
          <div
            class="absolute left-[23px] top-12 bottom-12 w-0.5 bg-gradient-to-b from-(--color-primary-300) via-(--color-primary-400) to-(--color-primary-200) rounded-full lg:left-[27px]"
            aria-hidden="true"
          ></div>

          <ol class="relative flex flex-col gap-0 list-none m-0 p-0">
            <!-- Step 1 -->
            <li class="relative flex gap-6 pb-12 lg:gap-8 lg:pb-14">
              <div class="relative z-[1] flex-shrink-0">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-(--color-primary-500) bg-(--color-base) font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark) lg:h-14 lg:w-14 lg:text-[1.25rem]">
                  1
                </div>
              </div>
              <div class="flex flex-col gap-2 pt-2 lg:pt-3">
                <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) lg:text-[1.375rem]">
                  Kostenloses Erstgespräch
                </h3>
                <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch]">
                  Bei einem unverbindlichen Erstbesuch in Ihren Räumlichkeiten besprechen wir, welche Unterstützung Sie genau brauchen.
                </p>
              </div>
            </li>

            <!-- Step 2 -->
            <li class="relative flex gap-6 pb-12 lg:gap-8 lg:pb-14">
              <div class="relative z-[1] flex-shrink-0">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-(--color-primary-500) bg-(--color-base) font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark) lg:h-14 lg:w-14 lg:text-[1.25rem]">
                  2
                </div>
              </div>
              <div class="flex flex-col gap-2 pt-2 lg:pt-3">
                <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) lg:text-[1.375rem]">
                  Maßgeschneidertes Paket
                </h3>
                <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch]">
                  Wir beraten Sie, welches Zeitpaket für Sie und Ihre Bedürfnisse das perfekte ist.
                </p>
              </div>
            </li>

            <!-- Step 3 -->
            <li class="relative flex gap-6 lg:gap-8">
              <div class="relative z-[1] flex-shrink-0">
                <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-(--color-primary-500) bg-(--color-base) font-[family-name:var(--font-heading)] text-[1.125rem] font-bold text-(--color-dark) lg:h-14 lg:w-14 lg:text-[1.25rem]">
                  3
                </div>
              </div>
              <div class="flex flex-col gap-2 pt-2 lg:pt-3">
                <h3 class="m-0 font-[family-name:var(--font-heading)] text-[1.25rem] font-bold text-(--color-dark) lg:text-[1.375rem]">
                  Individuelle Vorbereitung
                </h3>
                <p class="m-0 text-[0.9375rem] leading-[1.75] text-(--color-dark) opacity-80 max-w-[50ch]">
                  Wir notieren Ihre Wünsche und die Besonderheiten in Ihrem Zuhause ganz genau und bereiten unsere Mitarbeiterinnen individuell auf diese vor.
                </p>
              </div>
            </li>
          </ol>
        </div>

      </div>
    </div>
  </section>

  <!-- =============================================
       NOVA RAUMPFLEGE PARTNER SECTION
       ============================================= -->
  <section
    class="wh-section bg-(--color-base-alt)"
    aria-labelledby="nova-heading"
  >
    <div class="container-page">
      <!-- Split-Layout: Header links, Content rechts -->
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-20">

        <!-- LEFT: Header -->
        <div class="flex flex-col gap-4 lg:sticky lg:top-28">
          <span class="font-[family-name:var(--font-body)] text-[0.8125rem] font-bold tracking-[0.08em] text-(--color-primary-700) uppercase">
            Unser Partner
          </span>
          <h2
            id="nova-heading"
