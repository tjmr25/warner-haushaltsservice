---
import Layout from '../layouts/Layout.astro';

const team = [
  { name: 'Silke Raulf',    role: 'Geschäftsführerin'  },
  { name: 'Britta Meins',   role: 'Prokuristin'        },
  { name: 'Denise Minak',   role: 'Pflegefachkraft'    },
];

const milestones = [
  { year: '2000', text: 'Gründung des Warner Haushaltsservice in Hamburg' },
  { year: '2010', text: 'Vertrag mit dem vdek (§ 132 SGB V) – Haushaltshilfe nach ärztlicher Verordnung' },
  { year: '2019', text: 'Anerkennung als Angebot zur Unterstützung im Alltag (HmbPflEV) – Abrechnung über Pflegekasse möglich' },
  { year: 'Heute', text: 'Über 100 Mitarbeiterinnen in ca. 800 Haushalten in ganz Hamburg' },
];
---

<Layout
  title="Über uns – Warner Haushaltsservice"
  description="Seit 2000 bietet Warner Haushaltsservice Hamburg professionelle Haushaltshilfe. Über 100 Mitarbeiterinnen, 800 Haushalte, von der Stadt Hamburg anerkannt."
>

  <!-- ===== PAGE HERO ===== -->
  <section class="page-hero" aria-labelledby="ueber-hero-heading">
    <div class="container-content page-hero-inner">
      <div class="page-hero-text">
        <a href="/" class="breadcrumb">← Startseite</a>
        <p class="section-label">Wer wir sind</p>
        <h1 id="ueber-hero-heading">
          Über uns –<br />
          <span class="highlight-italic">Seit 2000 für Hamburg</span>
        </h1>
        <div class="accent-divider"></div>
        <p class="page-hero-sub">
          Die Warner Haushaltsservice GmbH bietet seit März 2000
          haushaltsbezogene Dienstleistungen in Hamburg an. Wir beschäftigen
          derzeit über 100 Haushaltshilfen in Teilzeit, die in ca. 800
          verschiedenen Haushalten in ganz Hamburg tätig sind.
        </p>
        <p class="page-hero-sub">
          Die Haushaltshilfen arbeiten zwischen 15 und 30 Stunden pro Woche und
          sind fest bei uns angestellt. Die Einsatzzeiten variieren von
          zweiwöchentlichen bis zu täglichen Einsätzen beim gleichen Kunden.
        </p>
      </div>

      <!-- Timeline side -->
      <div class="timeline-wrap">
        <h2 class="timeline-heading">Unsere Geschichte</h2>
        <ol class="timeline" role="list">
          {milestones.map((m, i) => (
            <li class="timeline-item">
              <div class="timeline-year" aria-label={`Jahr ${m.year}`}>{m.year}</div>
              <div class="timeline-text">{m.text}</div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===== TEAM ===== -->
  <section class="section-padding bg-warm-light" aria-labelledby="team-heading">
    <div class="container-content">
      <header class="section-header">
        <p class="section-label">Ihr Ansprechpartnerinnen</p>
        <h2 id="team-heading">Das Team</h2>
        <div class="accent-divider" style="margin: 1rem auto;"></div>
      </header>

      <div class="team-grid">
        {team.map(member => (
          <div class="team-card">
            <div class="team-avatar" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ffb730" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <h3>{member.name}</h3>
            <p class="team-role">{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== MITARBEITERINNEN ===== -->
  <section class="section-padding bg-warm-mid" aria-labelledby="mitarbeiter-heading">
    <div class="container-content">
      <div class="mitarbeiter-layout">
        <div class="mitarbeiter-image" aria-hidden="true">
          <img
            src="/images/hero-home.jpg"
            alt="Engagierte Mitarbeiterin beim Warner Haushaltsservice"
            width="540"
            height="420"
            loading="lazy"
          />
        </div>
        <div class="mitarbeiter-text">
          <p class="section-label">Unser Team</p>
          <h2 id="mitarbeiter-heading">Mitarbeiterinnen</h2>
          <div class="accent-divider"></div>
          <p>
            Zu unserem Team zählen mittlerweile über 100 Mitarbeiterinnen, von
            denen viele schon langjährig bei uns tätig sind und die die
            unterschiedlichsten kulturellen Hintergründe mitbringen.
          </p>
          <p>
            Wir sind stolz auf jede Einzelne und die gute Arbeit, die sie
            leistet.
          </p>
          <div class="info-box" style="margin-top: 1.5rem;">
            <p style="margin:0; font-size: 0.9375rem; color: #3d322a; line-height: 1.65;">
              <strong>Hinweis:</strong> Wenn Sie als Kunde ausschließlich eine
              „deutsche" Haushaltshilfe buchen möchten, sind wir leider nicht der
              richtige Dienstleister für Sie.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== GRÜNDER ===== -->
  <section class="section-padding founder-section" aria-labelledby="founder-heading">
    <div class="container-content">
      <div class="founder-card">
        <div class="founder-label">In Memoriam</div>
        <h2 id="founder-heading">Firmengründer</h2>
        <div class="accent-divider"></div>
        <h3 class="founder-name">Thomas Raulf</h3>
        <p class="founder-text">
          Nach Abschluss seines Psychologiestudiums gründete Herr Raulf im Jahre
          2000 zusammen mit Frau Sylvia Warner den Warner Haushaltsservice, den
          mittlerweile größten Anbieter hauswirtschaftlicher Dienstleistungen für
          Privathaushalte in Hamburg.
        </p>
        <p class="founder-memorial">
          Herr Raulf ist im Januar 2024 nach schwerer Krankheit verstorben.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="final-cta-ueber" aria-labelledby="cta-ueber-heading">
    <div class="container-content final-cta-inner">
      <h2 id="cta-ueber-heading">Lernen Sie uns persönlich kennen</h2>
      <p>Wir freuen uns auf Ihren Anruf oder Ihre Nachricht.</p>
      <div class="final-cta-buttons">
        <a href="/kontakt" class="btn-primary">Kontakt aufnehmen</a>
        <a href="tel:+4940298125400" class="final-cta-tel">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.0 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92z"/></svg>
          040 / 29 81 25 40
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  main { padding-top: 4.5rem; }
  @media (min-width: 1024px) { main { padding-top: 5rem; } }

  .breadcrumb {
    display: inline-flex; align-items: center; gap: 0.375rem;
    font-size: 0.875rem; color: #7d6e5e; text-decoration: none;
    margin-bottom: 1rem; transition: color 0.2s ease;
  }
  .breadcrumb:hover { color: #2a2018; }

  /* PAGE HERO */
  .page-hero { background-color: #fbf9f4; padding-top: 3rem; }
  .page-hero-inner {
    display: grid; grid-template-columns: 1fr;
    gap: 3rem; align-items: start; padding-bottom: 4rem;
  }
  @media (min-width: 1024px) {
    .page-hero-inner { grid-template-columns: 1fr 1fr; gap: 4rem; padding-top: 2rem; }
  }
  .page-hero-text h1 {
    font-size: clamp(2rem, 5vw, 2.875rem);
    font-weight: 800; margin: 0.5rem 0 0; line-height: 1.2; color: #2a2018;
  }
  .highlight-italic {
    color: #ffb730; font-style: italic;
    font-family: "Newsreader", Georgia, serif;
  }
  .page-hero-sub {
    font-size: 1rem; line-height: 1.75; color: #3d322a; margin: 0 0 1rem;
  }

  /* TIMELINE */
  .timeline-wrap { background-color: #fbf9f4; }
  .timeline-heading {
    font-size: 1.125rem; font-weight: 700; color: #2a2018;
    margin: 0 0 1.5rem;
  }

  .timeline { list-style: none; padding: 0; margin: 0; position: relative; }
  .timeline::before {
    content: '';
    position: absolute; left: 3.5rem; top: 0; bottom: 0;
    width: 2px; background-color: #e8e2d6;
  }

  .timeline-item {
    display: flex; align-items: flex-start; gap: 1.5rem;
    padding-bottom: 2rem; position: relative;
  }
  .timeline-item:last-child { padding-bottom: 0; }

  .timeline-year {
    width: 5rem; flex-shrink: 0;
    font-size: 0.8125rem; font-weight: 800;
    color: #a47038; text-align: right;
    padding-top: 0.1rem;
  }

  .timeline-text {
    flex: 1;
    font-size: 0.9375rem; line-height: 1.65; color: #3d322a;
    background-color: #fbf9f4;
    border: 1px solid #e8e2d6;
    border-radius: 0.75rem; padding: 0.875rem 1rem;
    position: relative;
  }
  .timeline-text::before {
    content: '';
    position: absolute; left: -0.5rem; top: 0.875rem;
    width: 0.875rem; height: 0.875rem;
    background-color: #ffb730; border-radius: 50%;
    border: 2px solid #fbf9f4;
  }

  /* SECTION HEADER */
  .section-header { text-align: center; max-width: 560px; margin: 0 auto 3rem; }
  .section-header h2 { font-size: clamp(1.625rem, 3.5vw, 2.25rem); margin: 0; }

  /* TEAM */
  .team-grid {
    display: grid; grid-template-columns: 1fr;
    gap: 1.5rem; max-width: 800px; margin: 0 auto;
  }
  @media (min-width: 640px) { .team-grid { grid-template-columns: repeat(3, 1fr); } }

  .team-card {
    background-color: #fbf9f4;
    border: 1px solid #e8e2d6; border-radius: 1rem;
    padding: 2rem; text-align: center;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .team-card:hover {
    box-shadow: 0 8px 24px rgba(42, 32, 24, 0.09);
    transform: translateY(-3px);
  }
  .team-avatar {
    width: 4rem; height: 4rem;
    background-color: #fff9eb; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1rem;
  }
  .team-card h3 { font-size: 1rem; margin: 0 0 0.25rem; color: #2a2018; }
  .team-role { font-size: 0.875rem; color: #7d6e5e; margin: 0; }

  /* MITARBEITERINNEN */
  .mitarbeiter-layout {
    display: grid; grid-template-columns: 1fr;
    gap: 3rem; align-items: center;
  }
  @media (min-width: 1024px) {
    .mitarbeiter-layout { grid-template-columns: 1fr 1fr; }
  }
  .mitarbeiter-image img {
    width: 100%; height: 360px; object-fit: cover;
    border-radius: 1.25rem; display: block;
  }
  @media (min-width: 1024px) {
    .mitarbeiter-image { display: block; }
    .mitarbeiter-image img { height: 420px; }
  }
  .mitarbeiter-text h2 { font-size: clamp(1.625rem, 3.5vw, 2.25rem); margin: 0.5rem 0 0; }
  .mitarbeiter-text p { font-size: 1rem; line-height: 1.75; color: #3d322a; margin: 0 0 1rem; }

  .info-box { background-color: #fff9eb; border-left: 4px solid #ffb730; border-radius: 0.5rem; padding: 1.25rem 1.5rem; }

  /* GRÜNDER */
  .founder-section { background-color: #fbf9f4; }
  .founder-card {
    max-width: 680px; margin: 0 auto;
    background-color: #f5f3ee;
    border: 1px solid #e8e2d6; border-radius: 1.25rem;
    padding: 2.5rem;
  }
  .founder-label {
    display: inline-block;
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #7d6e5e; margin-bottom: 0.5rem;
  }
  .founder-card h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin: 0.25rem 0 0; }
  .founder-name { font-size: 1.25rem; color: #2a2018; margin: 0 0 0.875rem; }
  .founder-text { font-size: 0.9375rem; line-height: 1.75; color: #3d322a; margin: 0 0 1rem; }
  .founder-memorial {
    font-size: 0.875rem; color: #7d6e5e; font-style: italic;
    margin: 0; padding-top: 0.75rem; border-top: 1px solid #e8e2d6;
  }

  /* FINAL CTA */
  .final-cta-ueber { background-color: #2a2018; padding: 4rem 0; }
  .final-cta-inner { text-align: center; max-width: 520px; margin: 0 auto; }
  .final-cta-ueber h2 { font-size: clamp(1.5rem, 3.5vw, 2.125rem); color: #ecd8b5; margin: 0 0 0.75rem; }
  .final-cta-ueber p { font-size: 1rem; color: #b8ab9a; margin: 0 0 2rem; }
  .final-cta-buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center; }
  .final-cta-tel {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: #ecd8b5; font-size: 1.0625rem; font-weight: 600;
    text-decoration: none; transition: color 0.2s ease;
  }
  .final-cta-tel:hover { color: #ffb730; }
</style>
